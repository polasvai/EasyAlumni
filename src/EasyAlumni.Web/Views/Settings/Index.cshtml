@model List<EasyAlumni.Core.Entities.SystemSetting>
@{
    ViewData["Title"] = "System Settings & Configuration";
    Layout = "_AdminLayout";
    var settingsDict = Model.ToDictionary(s => s.SettingKey, s => s.SettingValue);
    var notices = (List<EasyAlumni.Core.Entities.NoticePost>)ViewBag.Notices;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">System Settings &amp; Gateway Configuration</h2>
        <p class="text-muted small mb-0">SMS gateway, Meta WhatsApp, notification templates, and news board</p>
    </div>
    <div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            Dashboard
        </a>
    </div>
</div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabs Navigation -->
    <ul class="nav nav-pills mb-4 gap-2" id="settingsTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active rounded-pill px-4 fw-semibold" data-bs-toggle="pill" data-bs-target="#smsTab">
                <i class="fas fa-sms me-1"></i> SMS &amp; WhatsApp Gateways
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold" data-bs-toggle="pill" data-bs-target="#templatesTab">
                <i class="fas fa-comment-dots me-1"></i> Notification Templates
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold" data-bs-toggle="pill" data-bs-target="#noticesTab">
                <i class="fas fa-bullhorn me-1"></i> Notices &amp; News Board
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold" data-bs-toggle="pill" data-bs-target="#logsWebsiteTab">
                <i class="fas fa-terminal me-1 text-danger"></i> Error Logging (logs.website)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="settingsTabContent">
        <!-- 1. SMS & WhatsApp Gateway Tab -->
        <div class="tab-pane fade show active" id="smsTab">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="fas fa-paper-plane text-success me-2"></i> SMS Gateway API Setup</h5>
                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" onclick="checkBalance()">
                                <i class="fas fa-sync me-1"></i> Check Balance
                            </button>
                        </div>

                        <div id="balanceDisplay" class="alert alert-info py-2 small mb-4" style="display:none;"></div>

                        <form asp-controller="Settings" asp-action="UpdateAllSettings" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-semibold">SMS Gateway API Endpoint URL Template</label>
                                <input type="text" name="settings[SMSAPIURL]" class="form-control" value="@settingsDict.GetValueOrDefault("SMSAPIURL")" required />
                                <small class="text-muted">Placeholders: <code>$api_key</code>, <code>$sender_Id</code>, <code>$sms_number</code>, <code>$sms_text</code></small>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">SMS Sender Mask / ID</label>
                                    <input type="text" name="settings[SenderID]" class="form-control" value="@settingsDict.GetValueOrDefault("SenderID")" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">API Key / Token</label>
                                    <input type="text" name="settings[SmsAPIKey]" class="form-control" value="@settingsDict.GetValueOrDefault("SmsAPIKey")" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Balance Inquiry API URL</label>
                                    <input type="text" name="settings[SMSBalanceAPI]" class="form-control" value="@settingsDict.GetValueOrDefault("SMSBalanceAPI")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">SMS Lock (0=Active, 1=Paused)</label>
                                    <select name="settings[SMSLock]" class="form-select">
                                        <option value="0" selected="@(settingsDict.GetValueOrDefault("SMSLock") == "0")">0 - Active (Sending Enabled)</option>
                                        <option value="1" selected="@(settingsDict.GetValueOrDefault("SMSLock") == "1")">1 - Paused (Do Not Send)</option>
                                    </select>
                                </div>
                            </div>

                            <h5 class="fw-bold text-dark mt-4 mb-3 border-top pt-3"><i class="fab fa-whatsapp text-success me-2"></i> Meta WhatsApp Cloud API</h5>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">WhatsApp Cloud API Bearer Token</label>
                                    <input type="text" name="settings[WhatsAppApiKey]" class="form-control" value="@settingsDict.GetValueOrDefault("WhatsAppApiKey")" placeholder="EAAB..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">WhatsApp Phone Number ID</label>
                                    <input type="text" name="settings[WhatsAppPhoneId]" class="form-control" value="@settingsDict.GetValueOrDefault("WhatsAppPhoneId")" placeholder="1054..." />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success rounded-pill px-4">
                                <i class="fas fa-save me-1"></i> Save Gateway Settings
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Test SMS Sidebar -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-vial text-warning me-2"></i> Send Live Test SMS</h5>
                        <p class="small text-muted mb-3">Verify connectivity with your configured SMS gateway by dispatching a test message.</p>
                        <form asp-controller="Settings" asp-action="TestSms" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Destination Mobile</label>
                                <input type="tel" name="testMobile" class="form-control" placeholder="01XXXXXXXXX" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Test Message</label>
                                <textarea name="testMessage" class="form-control" rows="3" required>EasyAlumni Gateway Connectivity Test Message: System OK.</textarea>
                            </div>
                            <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold">
                                <i class="fas fa-paper-plane me-1"></i> Send Test SMS
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. JanataPay Gateway Tab (Moved to PaymentSettings) -->
        <div class="tab-pane fade" id="janataPayTab">
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                <div class="mb-3">
                    <i class="fas fa-credit-card fa-3x text-success"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Payment Settings &amp; Gateways has moved!</h4>
                <p class="text-muted mb-4">JanataPay gateway credentials, active payment method toggles, and manual accounts are now centrally managed in the dedicated Payment Settings hub.</p>
                <div>
                    <a asp-controller="PaymentSettings" asp-action="Index" class="btn btn-success rounded-pill px-4 fw-bold">
                        <i class="fas fa-arrow-right me-1"></i> Open Payment Settings Hub
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. Notification Templates Tab -->
        <div class="tab-pane fade" id="templatesTab">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-comment-dots text-primary me-2"></i> System SMS &amp; WhatsApp Message Templates</h5>
                <form asp-controller="Settings" asp-action="UpdateAllSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Enrollment SMS Template</label>
                        <textarea name="settings[EnrollSMS]" class="form-control" rows="2" required>@settingsDict.GetValueOrDefault("EnrollSMS")</textarea>
                        <small class="text-muted">Placeholders: <code>{Name}</code>, <code>{UserId}</code>, <code>{Password}</code></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Approved SMS Template</label>
                        <textarea name="settings[PaymentSMS]" class="form-control" rows="2" required>@settingsDict.GetValueOrDefault("PaymentSMS")</textarea>
                        <small class="text-muted">Placeholders: <code>{Name}</code>, <code>{TicketNo}</code>, <code>{Amount}</code>, <code>{EventName}</code>, <code>{PassUrl}</code></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Pending Payment SMS Template</label>
                        <textarea name="settings[PendingPaymentSMS]" class="form-control" rows="2" required>@settingsDict.GetValueOrDefault("PendingPaymentSMS")</textarea>
                        <small class="text-muted">Placeholders: <code>{Name}</code>, <code>{TicketNo}</code>, <code>{Amount}</code>, <code>{EventName}</code></small>
                    </div>

                    <button type="submit" class="btn btn-success rounded-pill px-4">
                        <i class="fas fa-save me-1"></i> Save Templates
                    </button>
                </form>
            </div>
        </div>

        <!-- 4. Notices & News Board Tab -->
        <div class="tab-pane fade" id="noticesTab">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="fas fa-bullhorn text-danger me-2"></i> Official Notices &amp; Circulars</h5>
                    <button type="button" class="btn btn-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addNoticeModal">
                        <i class="fas fa-plus me-1"></i> Publish Notice
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th>Publish Date</th>
                                <th>Category</th>
                                <th>Title</th>
                                <th>Attachment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in notices)
                            {
                                <tr>
                                    <td>@n.PublishDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-warning text-dark">@n.Category</span></td>
                                    <td><strong>@n.Title</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(n.AttachmentPath))
                                        {
                                            <a href="@n.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                                <i class="fas fa-file-download"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 5. Error Logging (logs.website) Tab -->
        <div class="tab-pane fade" id="logsWebsiteTab">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">
                                    <i class="fas fa-satellite-dish text-danger me-2"></i> logs.website Ingestion Configuration
                                </h5>
                                <p class="text-muted small mb-0">Direct centralized HTTP log collection and exception monitoring</p>
                            </div>
                            <span class="badge @(settingsDict.GetValueOrDefault("LogsWebsite_Enabled", "1") == "1" && !string.IsNullOrWhiteSpace(settingsDict.GetValueOrDefault("LogsWebsite_ApiToken")) ? "bg-success" : "bg-secondary") rounded-pill px-3 py-2">
                                @(settingsDict.GetValueOrDefault("LogsWebsite_Enabled", "1") == "1" && !string.IsNullOrWhiteSpace(settingsDict.GetValueOrDefault("LogsWebsite_ApiToken")) ? "Active & Streaming" : "Inactive / Missing Token")
                            </span>
                        </div>

                        <form asp-controller="Settings" asp-action="UpdateAllSettings" method="post">
                            @Html.AntiForgeryToken()

                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Error Logging State</label>
                                    <select name="settings[LogsWebsite_Enabled]" class="form-select">
                                        <option value="1" selected="@(settingsDict.GetValueOrDefault("LogsWebsite_Enabled", "1") == "1")">1 - Enabled (Send All Errors)</option>
                                        <option value="0" selected="@(settingsDict.GetValueOrDefault("LogsWebsite_Enabled", "1") == "0")">0 - Disabled (Do Not Send)</option>
                                    </select>
                                    <small class="text-muted">Toggle automatic dispatch of errors</small>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Ingestion API Endpoint URL</label>
                                    <input type="url" name="settings[LogsWebsite_ApiUrl]" class="form-control" 
                                           value="@(string.IsNullOrWhiteSpace(settingsDict.GetValueOrDefault("LogsWebsite_ApiUrl")) ? "https://logs.website/api/ingest" : settingsDict.GetValueOrDefault("LogsWebsite_ApiUrl"))" required />
                                    <small class="text-muted">Default: <code>https://logs.website/api/ingest</code></small>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">
                                    API Key / Ingestion Bearer Token <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-key text-warning"></i></span>
                                    <input type="password" id="logsWebsiteTokenInput" name="settings[LogsWebsite_ApiToken]" class="form-control font-monospace" 
                                           placeholder="e.g. rbd_a1b2c3d4e5f6g7h8..." 
                                           value="@settingsDict.GetValueOrDefault("LogsWebsite_ApiToken")" autocomplete="off" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('logsWebsiteTokenInput', this)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <small class="text-muted">
                                    Obtained from your <a href="https://logs.website/app" target="_blank" class="fw-semibold text-primary">logs.website dashboard</a> under <em>API tokens</em> (format: <code>rbd_...</code> or guest token <code>guest_...</code>).
                                </small>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                                    <i class="fas fa-save me-1"></i> Save logs.website Settings
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Test Connection Box -->
                    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="fas fa-paper-plane text-primary me-2"></i> Verify API Connection</h6>
                        <p class="text-muted small mb-3">
                            Send an immediate test log entry to <a href="https://logs.website" target="_blank">logs.website</a> to confirm your API Token and connectivity.
                        </p>
                        <form asp-controller="Settings" asp-action="TestLogsWebsite" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">
                                <i class="fas fa-vial me-1"></i> Send Test Log Event
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Info Side Card -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-light">
                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-info-circle text-info me-2"></i> How It Works</h6>
                        <p class="small text-muted mb-3">
                            When configured, <strong>all unhandled application exceptions, 500 crashes, critical warnings, and database errors</strong> occurring across your application are automatically captured and dispatched via HTTP POST to:
                        </p>
                        <div class="p-2 bg-dark text-white rounded font-monospace small mb-3" style="font-size: 0.78rem;">
                            POST https://logs.website/api/ingest<br>
                            Authorization: Bearer rbd_...
                        </div>
                        <ul class="small text-muted ps-3 mb-3">
                            <li><strong>Asynchronous &amp; Non-blocking:</strong> Logs are streamed in background workers without slowing user requests.</li>
                            <li><strong>Rich Diagnostics:</strong> Includes request URL, method, error stack trace, and user IP.</li>
                            <li><strong>Live Dashboard:</strong> View, search, and filter real-time logs anytime in your <a href="https://logs.website/app" target="_blank" class="fw-semibold">logs.website dashboard</a>.</li>
                        </ul>
                        @if (!string.IsNullOrWhiteSpace(settingsDict.GetValueOrDefault("LogsWebsite_ApiToken")))
                        {
                            var tokenVal = settingsDict.GetValueOrDefault("LogsWebsite_ApiToken")!.Trim();
                            <div class="d-grid mt-3">
                                <a href="https://logs.website/app/@tokenVal" target="_blank" class="btn btn-outline-dark rounded-pill btn-sm fw-bold">
                                    <i class="fas fa-external-link-alt me-1"></i> Open Read-Only Web Viewer
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- Add Notice Modal -->
<div class="modal fade" id="addNoticeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="Settings" asp-action="AddNotice" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">Publish Official Notice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notice Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category</label>
                        <select name="category" class="form-select">
                            <option value="Notice">Notice</option>
                            <option value="Event Update">Event Update</option>
                            <option value="Circular">Circular</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Content HTML / Text <span class="text-danger">*</span></label>
                        <textarea name="contentHtml" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">File Attachment (PDF/Image, Optional)</label>
                        <input type="file" name="attachmentFile" class="form-control" accept=".pdf,.jpg,.png" />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Publish</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function checkBalance() {
            fetch('/Settings/CheckBalance')
                .then(r => r.json())
                .then(d => {
                    const el = document.getElementById('balanceDisplay');
                    el.style.display = 'block';
                    el.innerHTML = `<strong>Live SMS Gateway Balance:</strong> ${d.balance}`;
                })
                .catch(err => {
                    alert("Could not fetch balance from gateway.");
                });
        }

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input) {
                if (input.type === 'password') {
                    input.type = 'text';
                    btn.innerHTML = '<i class="fas fa-eye-slash"></i>';
                } else {
                    input.type = 'password';
                    btn.innerHTML = '<i class="fas fa-eye"></i>';
                }
            }
        }

        // Keep active tab on refresh or post
        document.addEventListener('DOMContentLoaded', () => {
            const hash = window.location.hash;
            if (hash) {
                const targetBtn = document.querySelector(`button[data-bs-target="${hash}"]`);
                if (targetBtn) {
                    const tab = new bootstrap.Tab(targetBtn);
                    tab.show();
                }
            }

            document.querySelectorAll('#settingsTab button').forEach(btn => {
                btn.addEventListener('shown.bs.tab', (e) => {
                    const target = e.target.getAttribute('data-bs-target');
                    if (target) {
                        history.replaceState(null, null, target);
                    }
                });
            });
        });
    </script>
}
