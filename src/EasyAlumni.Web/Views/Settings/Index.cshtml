@model List<EasyAlumni.Core.Entities.SystemSetting>
@{
    ViewData["Title"] = "System Settings & Configuration";
    Layout = "_AdminLayout";
    var settingsDict = Model.ToDictionary(s => s.SettingKey, s => s.SettingValue);
    var notices = (List<EasyAlumni.Core.Entities.NoticePost>)ViewBag.Notices;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">System Settings &amp; Gateway Configuration</h2>
        <p class="text-muted small mb-0">SMS gateway, Meta WhatsApp, message templates, and landing page CMS</p>
    </div>
    <div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            Dashboard
        </a>
    </div>
</div>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabs Navigation -->
    <ul class="nav nav-pills mb-4 gap-2" id="settingsTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active rounded-pill px-4 fw-semibold" data-bs-toggle="pill" data-bs-target="#smsTab">
                <i class="fas fa-sms me-1"></i> SMS &amp; WhatsApp Gateways
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold text-success border border-success" data-bs-toggle="pill" data-bs-target="#janataPayTab">
                <i class="fas fa-university me-1"></i> JanataPay Gateway (জনতা পে)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold" data-bs-toggle="pill" data-bs-target="#templatesTab">
                <i class="fas fa-comment-dots me-1"></i> Notification Templates
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold" data-bs-toggle="pill" data-bs-target="#cmsTab">
                <i class="fas fa-desktop me-1"></i> Landing Page CMS
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-semibold" data-bs-toggle="pill" data-bs-target="#noticesTab">
                <i class="fas fa-bullhorn me-1"></i> Notices &amp; News Board
            </button>
        </li>
    </ul>

    <div class="tab-content" id="settingsTabContent">
        <!-- 1. SMS & WhatsApp Gateway Tab -->
        <div class="tab-pane fade show active" id="smsTab">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0"><i class="fas fa-paper-plane text-success me-2"></i> SMS Gateway API Setup</h5>
                            <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3" onclick="checkBalance()">
                                <i class="fas fa-sync me-1"></i> Check Balance
                            </button>
                        </div>

                        <div id="balanceDisplay" class="alert alert-info py-2 small mb-4" style="display:none;"></div>

                        <form asp-controller="Settings" asp-action="UpdateAllSettings" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-semibold">SMS Gateway API Endpoint URL Template</label>
                                <input type="text" name="settings[SMSAPIURL]" class="form-control" value="@settingsDict.GetValueOrDefault("SMSAPIURL")" required />
                                <small class="text-muted">Placeholders: <code>$api_key</code>, <code>$sender_Id</code>, <code>$sms_number</code>, <code>$sms_text</code></small>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">SMS Sender Mask / ID</label>
                                    <input type="text" name="settings[SenderID]" class="form-control" value="@settingsDict.GetValueOrDefault("SenderID")" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">API Key / Token</label>
                                    <input type="text" name="settings[SmsAPIKey]" class="form-control" value="@settingsDict.GetValueOrDefault("SmsAPIKey")" required />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">Balance Inquiry API URL</label>
                                    <input type="text" name="settings[SMSBalanceAPI]" class="form-control" value="@settingsDict.GetValueOrDefault("SMSBalanceAPI")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">SMS Lock (0=Active, 1=Paused)</label>
                                    <select name="settings[SMSLock]" class="form-select">
                                        <option value="0" selected="@(settingsDict.GetValueOrDefault("SMSLock") == "0")">0 - Active (Sending Enabled)</option>
                                        <option value="1" selected="@(settingsDict.GetValueOrDefault("SMSLock") == "1")">1 - Paused (Do Not Send)</option>
                                    </select>
                                </div>
                            </div>

                            <h5 class="fw-bold text-dark mt-4 mb-3 border-top pt-3"><i class="fab fa-whatsapp text-success me-2"></i> Meta WhatsApp Cloud API</h5>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">WhatsApp Cloud API Bearer Token</label>
                                    <input type="text" name="settings[WhatsAppApiKey]" class="form-control" value="@settingsDict.GetValueOrDefault("WhatsAppApiKey")" placeholder="EAAB..." />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">WhatsApp Phone Number ID</label>
                                    <input type="text" name="settings[WhatsAppPhoneId]" class="form-control" value="@settingsDict.GetValueOrDefault("WhatsAppPhoneId")" placeholder="1054..." />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success rounded-pill px-4">
                                <i class="fas fa-save me-1"></i> Save Gateway Settings
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Test SMS Sidebar -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h5 class="fw-bold text-dark mb-3"><i class="fas fa-vial text-warning me-2"></i> Send Live Test SMS</h5>
                        <p class="small text-muted mb-3">Verify connectivity with your configured SMS gateway by dispatching a test message.</p>
                        <form asp-controller="Settings" asp-action="TestSms" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Destination Mobile</label>
                                <input type="tel" name="testMobile" class="form-control" placeholder="01XXXXXXXXX" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Test Message</label>
                                <textarea name="testMessage" class="form-control" rows="3" required>EasyAlumni Gateway Connectivity Test Message: System OK.</textarea>
                            </div>
                            <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold">
                                <i class="fas fa-paper-plane me-1"></i> Send Test SMS
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. JanataPay Gateway Tab -->
        <div class="tab-pane fade" id="janataPayTab">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-1"><i class="fas fa-university text-success me-2"></i> JanataPay (Janata Bank) Gateway Settings</h5>
                                <small class="text-muted">Configure live or sandbox merchant credentials, encryption keys, and network routing.</small>
                            </div>
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                <i class="fas fa-lock me-1"></i> AES-256-GCM + RSA-OAEP
                            </span>
                        </div>

                        <form asp-controller="Settings" asp-action="UpdateAllSettings" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-semibold">JanataPay API Base URL <span class="text-danger">*</span></label>
                                <input type="url" name="settings[JanataPayBaseUrl]" class="form-control" 
                                       value="@settingsDict.GetValueOrDefault("JanataPayBaseUrl", "https://sandbox-pg.janatapay.com")" required />
                                <small class="text-muted">
                                    <strong>Sandbox:</strong> <code>https://sandbox-pg.janatapay.com</code> | 
                                    <strong>Production (Live):</strong> Change to the live production endpoint provided by Janata Bank.
                                </small>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Merchant UID <span class="text-danger">*</span></label>
                                    <input type="text" name="settings[JanataPayMerchantUid]" class="form-control" 
                                           value="@settingsDict.GetValueOrDefault("JanataPayMerchantUid")" required />
                                    <small class="text-muted">Assigned merchant UID (e.g. <code>6521171673</code>)</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">API Username <span class="text-danger">*</span></label>
                                    <input type="text" name="settings[JanataPayUsername]" class="form-control" 
                                           value="@settingsDict.GetValueOrDefault("JanataPayUsername")" required />
                                    <small class="text-muted">Assigned gateway username (e.g. <code>j8Dx4778daD160</code>)</small>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">API Password <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="password" name="settings[JanataPayPassword]" id="janataPayPasswordInput" class="form-control" 
                                           value="@settingsDict.GetValueOrDefault("JanataPayPassword")" required />
                                    <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('janataPayPasswordInput', this)">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <small class="text-muted">Gateway secret account password.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Gateway RSA 2048-bit Public Key (Base64) <span class="text-danger">*</span></label>
                                <textarea name="settings[JanataPayPublicKey]" class="form-control font-monospace small" rows="4" required>@settingsDict.GetValueOrDefault("JanataPayPublicKey")</textarea>
                                <small class="text-muted">
                                    Paste the 2048-bit RSA SPKI public key provided by Janata Bank. (With or without <code>BEGIN/END PUBLIC KEY</code> headers).
                                </small>
                            </div>

                            <h6 class="fw-bold text-dark mt-4 mb-2 border-top pt-3"><i class="fas fa-network-wired text-primary me-2"></i> Firewall &amp; Network Tunneling</h6>
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold">Egress Routing Mode</label>
                                    <select name="settings[JanataPayUseProxy]" class="form-select">
                                        <option value="1" selected="@(settingsDict.GetValueOrDefault("JanataPayUseProxy", "1") == "1")">Route via BD SOCKS5 Tunnel (Recommended)</option>
                                        <option value="0" selected="@(settingsDict.GetValueOrDefault("JanataPayUseProxy") == "0")">Direct Egress (Foreign Server IP)</option>
                                    </select>
                                    <small class="text-muted">JanataPay sandbox firewall blocks non-Bangladesh IPs.</small>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold">SOCKS5 Proxy Endpoint</label>
                                    <input type="text" name="settings[JanataPaySocks5Proxy]" class="form-control" 
                                           value="@settingsDict.GetValueOrDefault("JanataPaySocks5Proxy", "socks5://127.0.0.1:1080")" />
                                    <small class="text-muted">Local port connected to Bangladesh connector agent tunnel.</small>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold">Callback Base URL</label>
                                <input type="url" name="settings[JanataPayCallbackBaseUrl]" class="form-control" 
                                       value="@settingsDict.GetValueOrDefault("JanataPayCallbackBaseUrl", "https://alumni.snhghs.edu.bd")" required />
                                <small class="text-muted">Base URL where JanataPay will redirect payer after transaction completion.</small>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
                                    <i class="fas fa-save me-1"></i> Save JanataPay Settings
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Live Test & Diagnostics Column -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
                        <h6 class="fw-bold text-dark mb-3"><i class="fas fa-vial text-info me-2"></i> Test Gateway Connection</h6>
                        <p class="small text-muted mb-3">
                            Verifies the cryptographic handshake (AES-GCM + RSA-OAEP) with JanataPay using current credentials and retrieves a live Bearer JWT.
                        </p>

                        <form asp-controller="Settings" asp-action="TestJanataPay" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success w-100 rounded-pill fw-semibold">
                                <i class="fas fa-bolt me-1"></i> Test JanataPay Handshake
                            </button>
                        </form>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="fas fa-info-circle text-primary me-2"></i> Switching to Production</h6>
                        <ol class="small text-muted ps-3 mb-0">
                            <li class="mb-2">Change <strong>API Base URL</strong> to the live production URL given by Janata Bank.</li>
                            <li class="mb-2">Enter your live <strong>Merchant UID</strong>, <strong>Username</strong>, and <strong>Password</strong>.</li>
                            <li class="mb-2">Replace the <strong>RSA Public Key</strong> with Janata Bank's production key.</li>
                            <li class="mb-2">Click <strong>Save JanataPay Settings</strong> and run <strong>Test Handshake</strong> to verify.</li>
                        </ol>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Notification Templates Tab -->
        <div class="tab-pane fade" id="templatesTab">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-comment-dots text-primary me-2"></i> SMS &amp; WhatsApp Notification Templates</h5>
                <p class="text-muted small mb-4">Supported replacement tokens: <code>{Name}</code>, <code>{UserId}</code>, <code>{TicketNo}</code>, <code>{Amount}</code>, <code>{EventName}</code>, <code>{PassUrl}</code>, <code>{Password}</code></p>

                <form asp-controller="Settings" asp-action="UpdateAllSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-success">Registration Pending SMS (Sent when alumnus submits form)</label>
                        <textarea name="settings[PendingPaymentSMS]" class="form-control" rows="2" required>@settingsDict.GetValueOrDefault("PendingPaymentSMS")</textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-primary">Payment Approved SMS (Sent when payment is approved)</label>
                        <textarea name="settings[PaymentSMS]" class="form-control" rows="2" required>@settingsDict.GetValueOrDefault("PaymentSMS")</textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark">Alumni Account Enrollment SMS</label>
                        <textarea name="settings[EnrollSMS]" class="form-control" rows="2" required>@settingsDict.GetValueOrDefault("EnrollSMS")</textarea>
                    </div>

                    <button type="submit" class="btn btn-success rounded-pill px-4">
                        <i class="fas fa-save me-1"></i> Save Message Templates
                    </button>
                </form>
            </div>
        </div>

        <!-- 3. Landing Page CMS Tab -->
        <div class="tab-pane fade" id="cmsTab">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3"><i class="fas fa-desktop text-success me-2"></i> Landing Page Custom Content</h5>
                <form asp-controller="Settings" asp-action="UpdateAllSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hero Heading (English)</label>
                            <input type="text" name="settings[LandingHeroTitle]" class="form-control" value="@settingsDict.GetValueOrDefault("LandingHeroTitle")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hero Subtitle (Bangla)</label>
                            <input type="text" name="settings[LandingHeroSubtitle]" class="form-control" value="@settingsDict.GetValueOrDefault("LandingHeroSubtitle")" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Event Target Date &amp; Time (For Countdown)</label>
                            <input type="datetime-local" name="settings[ReunionDate]" class="form-control" value="@settingsDict.GetValueOrDefault("ReunionDate")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Event Venue &amp; Location</label>
                            <input type="text" name="settings[EventVenue]" class="form-control" value="@settingsDict.GetValueOrDefault("EventVenue")" required />
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mt-4 mb-3 border-top pt-3"><i class="fas fa-money-bill text-danger me-2"></i> Manual Mobile Banking Account Numbers</h5>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">bKash Account Number</label>
                            <input type="text" name="settings[ManualBkashNumber]" class="form-control" value="@settingsDict.GetValueOrDefault("ManualBkashNumber")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Nagad Account Number</label>
                            <input type="text" name="settings[ManualNagadNumber]" class="form-control" value="@settingsDict.GetValueOrDefault("ManualNagadNumber")" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Rocket Account Number</label>
                            <input type="text" name="settings[ManualRocketNumber]" class="form-control" value="@settingsDict.GetValueOrDefault("ManualRocketNumber")" />
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mt-4 mb-3 border-top pt-3"><i class="fas fa-phone-alt text-primary me-2"></i> Help Desk &amp; Contact Information</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Hotline Numbers</label>
                            <input type="text" name="settings[ContactHotline]" class="form-control" value="@settingsDict.GetValueOrDefault("ContactHotline")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Official Inquiry Email</label>
                            <input type="email" name="settings[ContactEmail]" class="form-control" value="@settingsDict.GetValueOrDefault("ContactEmail")" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success rounded-pill px-4">
                        <i class="fas fa-save me-1"></i> Save CMS Settings
                    </button>
                </form>
            </div>
        </div>

        <!-- 4. Notices & News Board Tab -->
        <div class="tab-pane fade" id="noticesTab">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="fas fa-bullhorn text-danger me-2"></i> Official Notices &amp; Circulars</h5>
                    <button type="button" class="btn btn-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#addNoticeModal">
                        <i class="fas fa-plus me-1"></i> Publish Notice
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th>Publish Date</th>
                                <th>Category</th>
                                <th>Title</th>
                                <th>Attachment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var n in notices)
                            {
                                <tr>
                                    <td>@n.PublishDate.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-warning text-dark">@n.Category</span></td>
                                    <td><strong>@n.Title</strong></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(n.AttachmentPath))
                                        {
                                            <a href="@n.AttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2">
                                                <i class="fas fa-file-download"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">None</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

<!-- Add Notice Modal -->
<div class="modal fade" id="addNoticeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="Settings" asp-action="AddNotice" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">Publish Official Notice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notice Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Category</label>
                        <select name="category" class="form-select">
                            <option value="Notice">Notice</option>
                            <option value="Event Update">Event Update</option>
                            <option value="Circular">Circular</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Content HTML / Text <span class="text-danger">*</span></label>
                        <textarea name="contentHtml" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">File Attachment (PDF/Image, Optional)</label>
                        <input type="file" name="attachmentFile" class="form-control" accept=".pdf,.jpg,.png" />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Publish</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function checkBalance() {
            fetch('/Settings/CheckBalance')
                .then(r => r.json())
                .then(d => {
                    const el = document.getElementById('balanceDisplay');
                    el.style.display = 'block';
                    el.innerHTML = `<strong>Live SMS Gateway Balance:</strong> ${d.balance}`;
                })
                .catch(err => {
                    alert("Could not fetch balance from gateway.");
                });
        }

        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input) {
                if (input.type === 'password') {
                    input.type = 'text';
                    btn.innerHTML = '<i class="fas fa-eye-slash"></i>';
                } else {
                    input.type = 'password';
                    btn.innerHTML = '<i class="fas fa-eye"></i>';
                }
            }
        }

        // Keep active tab on refresh or post
        document.addEventListener('DOMContentLoaded', () => {
            const hash = window.location.hash;
            if (hash) {
                const targetBtn = document.querySelector(`button[data-bs-target="${hash}"]`);
                if (targetBtn) {
                    const tab = new bootstrap.Tab(targetBtn);
                    tab.show();
                }
            }

            document.querySelectorAll('#settingsTab button').forEach(btn => {
                btn.addEventListener('shown.bs.tab', (e) => {
                    const target = e.target.getAttribute('data-bs-target');
                    if (target) {
                        history.replaceState(null, null, target);
                    }
                });
            });
        });
    </script>
}
