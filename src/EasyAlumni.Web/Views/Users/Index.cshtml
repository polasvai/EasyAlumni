@model EasyAlumni.Web.ViewModels.UserListIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User & Access Management";
    var isSuperAdmin = User.IsInRole("SuperAdmin");
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-1 text-dark">User &amp; Access Management</h4>
        <p class="text-muted small mb-0">Provision administrative staff, assign role permissions, reset credentials, and control access.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="AccessMatrix" class="btn btn-outline-dark rounded-3 px-3 py-2">
            Role Access Matrix
        </a>
        <button type="button" class="btn btn-success rounded-3 px-3 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#createUserModal">
            + Add New User
        </button>
    </div>
</div>

<!-- KPI Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 me-3">
                    <span class="fw-bold fs-4">👥</span>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalUsers</h3>
                    <div class="text-muted small">Total System Users</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 me-3">
                    <span class="fw-bold fs-4">🛡️</span>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.AdminCount</h3>
                    <div class="text-muted small">Admins &amp; SuperAdmins</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3 me-3">
                    <span class="fw-bold fs-4">💰</span>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.AccountsCount</h3>
                    <div class="text-muted small">Accounts Officers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center">
                <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 me-3">
                    <span class="fw-bold fs-4">🎟️</span>
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">@Model.VolunteerCount</h3>
                    <div class="text-muted small">Gate Volunteers</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Search by name, email, phone, code..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select">
                    <option value="All" selected="@(Model.SelectedRoleFilter == "All" ? "selected" : null)">All Roles</option>
                    @foreach (var r in Model.AvailableRoles)
                    {
                        <option value="@r" selected="@(Model.SelectedRoleFilter == r ? "selected" : null)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">
                    Filter
                </button>
            </div>
            <div class="col-md-3 text-md-end">
                @if (!string.IsNullOrEmpty(Model.SearchQuery) || (Model.SelectedRoleFilter != "All" && !string.IsNullOrEmpty(Model.SelectedRoleFilter)))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear Filters</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Users Table Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-bottom p-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">Registered Users Directory</h6>
        <span class="badge bg-light text-muted border">Showing @Model.Users.Count accounts</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">User</th>
                    <th>Mobile</th>
                    <th>Assigned Roles</th>
                    <th>Account Status</th>
                    <th>Created</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    foreach (var user in Model.Users)
                    {
                        var initials = string.Join("", user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
                        if (string.IsNullOrEmpty(initials)) initials = "U";

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center me-3" style="width: 42px; height: 42px; font-size: 0.9rem;">
                                        @initials
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">
                                            @user.FullName
                                            @if (user.IsCurrentLoggedInUser)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success ms-1">You</span>
                                            }
                                        </div>
                                        <div class="small text-muted">@user.Email</div>
                                        @if (!string.IsNullOrEmpty(user.UserCode))
                                        {
                                            <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.7rem;">@user.UserCode</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)
                            </td>
                            <td>
                                @if (user.Roles.Any())
                                {
                                    foreach (var r in user.Roles)
                                    {
                                        var badgeClass = r switch
                                        {
                                            "SuperAdmin" => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
                                            "Admin" => "bg-success bg-opacity-10 text-success border border-success border-opacity-25",
                                            "Accounts" => "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25",
                                            "Volunteer" => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25",
                                            _ => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25"
                                        };
                                        <span class="badge @badgeClass me-1">@r</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">No Roles</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-1">Disabled</span>
                                }
                            </td>
                            <td>
                                <span class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-primary" onclick="openEditModal('@user.Id')">
                                        Edit
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="openResetPasswordModal('@user.Id', '@user.FullName', '@user.Email')">
                                        Reset Pass
                                    </button>
                                    @if (!user.IsCurrentLoggedInUser)
                                    {
                                        <form asp-action="ToggleStatus" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to change status for @user.FullName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-outline-danger">
                                                    Disable
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-success">
                                                    Activate
                                                </button>
                                            }
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <p class="mb-0">No users found matching your search or role filter.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create New User -->
<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom p-4">
                <h5 class="modal-title fw-bold text-dark">Add New Staff / Admin User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control" placeholder="e.g. Mahbuba Akhter" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="Email" class="form-control" placeholder="e.g. staff@snhghs.edu.bd" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mobile Number</label>
                        <input type="tel" name="PhoneNumber" class="form-control" placeholder="e.g. 01711000000" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                            <input type="password" name="Password" class="form-control" placeholder="Min. 6 chars" required minlength="6" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                            <input type="password" name="ConfirmPassword" class="form-control" placeholder="Re-type password" required minlength="6" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Assign Roles</label>
                        <div class="row g-2">
                            @if (isSuperAdmin)
                            {
                                <div class="col-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedRoles" value="SuperAdmin" id="createRoleSuperAdmin">
                                        <label class="form-check-label fw-bold text-danger" for="createRoleSuperAdmin">SuperAdmin</label>
                                    </div>
                                </div>
                            }
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedRoles" value="Admin" id="createRoleAdmin" checked>
                                    <label class="form-check-label fw-semibold text-success" for="createRoleAdmin">Admin</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedRoles" value="Accounts" id="createRoleAccounts">
                                    <label class="form-check-label fw-semibold text-primary" for="createRoleAccounts">Accounts</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedRoles" value="Volunteer" id="createRoleVolunteer">
                                    <label class="form-check-label fw-semibold text-warning" for="createRoleVolunteer">Volunteer</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="createIsActive" checked>
                        <label class="form-check-label fw-semibold" for="createIsActive">Account Active Immediately</label>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success px-4">Create User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit User -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom p-4">
                <h5 class="modal-title fw-bold text-dark">Edit User Profile &amp; Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editUserId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" id="editFullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="Email" id="editEmail" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mobile Number</label>
                        <input type="tel" name="PhoneNumber" id="editPhoneNumber" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold d-block">Security Roles</label>
                        <div class="row g-2">
                            @if (isSuperAdmin)
                            {
                                <div class="col-6">
                                    <div class="form-check">
                                        <input class="form-check-input edit-role-chk" type="checkbox" name="SelectedRoles" value="SuperAdmin" id="editRoleSuperAdmin">
                                        <label class="form-check-label fw-bold text-danger" for="editRoleSuperAdmin">SuperAdmin</label>
                                    </div>
                                </div>
                            }
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input edit-role-chk" type="checkbox" name="SelectedRoles" value="Admin" id="editRoleAdmin">
                                    <label class="form-check-label fw-semibold text-success" for="editRoleAdmin">Admin</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input edit-role-chk" type="checkbox" name="SelectedRoles" value="Accounts" id="editRoleAccounts">
                                    <label class="form-check-label fw-semibold text-primary" for="editRoleAccounts">Accounts</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input edit-role-chk" type="checkbox" name="SelectedRoles" value="Volunteer" id="editRoleVolunteer">
                                    <label class="form-check-label fw-semibold text-warning" for="editRoleVolunteer">Volunteer</label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input edit-role-chk" type="checkbox" name="SelectedRoles" value="Alumni" id="editRoleAlumni">
                                    <label class="form-check-label fw-semibold text-secondary" for="editRoleAlumni">Alumni</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch mt-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editIsActive">
                        <label class="form-check-label fw-semibold" for="editIsActive">Account Active</label>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Update User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reset Password -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom p-4">
                <h5 class="modal-title fw-bold text-dark">Reset User Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="UserId" id="resetUserId" />
                <div class="modal-body p-4">
                    <div class="alert alert-light border rounded-3 p-3 mb-3">
                        <div class="small text-muted">Resetting credentials for:</div>
                        <div class="fw-bold text-dark" id="resetUserDisplay">User</div>
                        <div class="small text-muted" id="resetEmailDisplay">email</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password <span class="text-danger">*</span></label>
                        <input type="password" name="NewPassword" class="form-control" placeholder="Enter new strong password" required minlength="6" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Confirm New Password <span class="text-danger">*</span></label>
                        <input type="password" name="ConfirmPassword" class="form-control" placeholder="Re-type new password" required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold">Set New Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function openEditModal(userId) {
            try {
                const response = await fetch(`/Users/GetUserJson?id=${userId}`);
                if (!response.ok) throw new Error('User fetch failed');
                const user = await response.json();

                document.getElementById('editUserId').value = user.id;
                document.getElementById('editFullName').value = user.fullName;
                document.getElementById('editEmail').value = user.email;
                document.getElementById('editPhoneNumber').value = user.phoneNumber || '';
                document.getElementById('editIsActive').checked = user.isActive;

                // Reset and check roles
                document.querySelectorAll('.edit-role-chk').forEach(chk => {
                    chk.checked = user.roles && user.roles.includes(chk.value);
                });

                const modal = new bootstrap.Modal(document.getElementById('editUserModal'));
                modal.show();
            } catch (err) {
                alert('Unable to load user details for editing.');
            }
        }

        function openResetPasswordModal(userId, fullName, email) {
            document.getElementById('resetUserId').value = userId;
            document.getElementById('resetUserDisplay').innerText = fullName;
            document.getElementById('resetEmailDisplay').innerText = email;
            const modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
            modal.show();
        }
    </script>
}
