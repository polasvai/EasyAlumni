@model EasyAlumni.Core.Entities.Donation
@{
    Layout = null;
    ViewData["Title"] = $"Donation Receipt - {Model.DonationTrackingNo}";
    var isApproved = Model.Status == EasyAlumni.Core.Enums.PaymentStatus.Approved;
    var qrBase64 = ViewBag.QrCodeBase64 as string;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Donation Receipt - @Model.DonationTrackingNo</title>
    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', 'Hind Siliguri', sans-serif;
            background-color: #f1f5f9;
            padding: 30px 15px;
            color: #1e293b;
        }

        .receipt-card {
            max-width: 680px;
            margin: 0 auto;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid #e2e8f0;
            position: relative;
        }

        .receipt-header {
            background: linear-gradient(135deg, #0f172a 0%, #004d38 100%);
            color: #fff;
            padding: 28px 24px;
            text-align: center;
            position: relative;
        }

        .receipt-watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-25deg);
            font-size: 5rem;
            font-weight: 800;
            opacity: 0.04;
            pointer-events: none;
            text-transform: uppercase;
            letter-spacing: 5px;
        }

        .org-logo {
            width: 70px;
            height: 70px;
            object-fit: contain;
            background: white;
            padding: 4px;
            border-radius: 50%;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            margin-bottom: 12px;
        }

        .receipt-title {
            font-size: 1.35rem;
            font-weight: 700;
            margin-bottom: 4px;
            letter-spacing: 0.5px;
        }

        .receipt-subtitle {
            font-size: 0.85rem;
            color: #cbd5e1;
            margin-bottom: 0;
        }

        .receipt-body {
            padding: 28px;
            background: #ffffff;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-approved {
            background-color: #dcfce7;
            color: #15803d;
            border: 1px solid #86efac;
        }

        .status-pending {
            background-color: #fef9c3;
            color: #854d0e;
            border: 1px solid #fde047;
        }

        .status-failed {
            background-color: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
        }

        .amount-box {
            background: #f8fafc;
            border: 2px dashed #cbd5e1;
            border-radius: 14px;
            padding: 16px;
            text-align: center;
            margin: 20px 0;
        }

        .amount-val {
            font-size: 2.2rem;
            font-weight: 800;
            color: #004d38;
            margin: 0;
            line-height: 1.2;
        }

        .amount-label {
            font-size: 0.8rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 9px 0;
            border-bottom: 1px solid #f1f5f9;
            font-size: 0.92rem;
        }

        .detail-label {
            color: #64748b;
            font-weight: 500;
        }

        .detail-val {
            color: #0f172a;
            font-weight: 600;
            text-align: right;
        }

        .receipt-footer {
            background: #f8fafc;
            padding: 18px 24px;
            border-top: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .action-bar {
            max-width: 680px;
            margin: 20px auto 0;
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .receipt-card {
                box-shadow: none;
                border: 1px solid #ccc;
                max-width: 100%;
                page-break-inside: avoid;
            }
            .action-bar, .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show max-w-680 mx-auto mb-3" style="max-width:680px;" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show max-w-680 mx-auto mb-3" style="max-width:680px;" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="receipt-card">
        <div class="receipt-watermark">DONATION</div>

        <!-- Header -->
        <div class="receipt-header">
            <img src="/images/logo.png" alt="SNHGHS Logo" class="org-logo" onerror="this.src='/favicon.ico'; this.style.display='none';" />
            <h1 class="receipt-title">Suratunnesa Memorial Higher Girls' High School</h1>
            <p class="receipt-subtitle">Official Voluntary Contribution & Donation Receipt</p>
        </div>

        <!-- Body -->
        <div class="receipt-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <span class="text-muted small">Tracking Number</span>
                    <h5 class="fw-bold mb-0 text-primary">@Model.DonationTrackingNo</h5>
                </div>
                <div>
                    @if (isApproved)
                    {
                        <span class="status-badge status-approved">
                            <i class="fas fa-check-circle"></i> Verified & Received
                        </span>
                    }
                    else if (Model.Status == EasyAlumni.Core.Enums.PaymentStatus.Pending)
                    {
                        <span class="status-badge status-pending">
                            <i class="fas fa-clock"></i> Verification Pending
                        </span>
                    }
                    else
                    {
                        <span class="status-badge status-failed">
                            <i class="fas fa-times-circle"></i> @Model.Status
                        </span>
                    }
                </div>
            </div>

            <!-- Amount Showcase -->
            <div class="amount-box">
                <div class="amount-label">Contributed Amount</div>
                <div class="amount-val">৳ @Model.Amount.ToString("N2")</div>
                <small class="text-muted">Bangladeshi Taka (BDT)</small>
            </div>

            <!-- Donor & Transaction Information -->
            <div class="details-list">
                <div class="detail-row">
                    <span class="detail-label">Donor Name:</span>
                    <span class="detail-val">
                        @(Model.IsAnonymous ? $"{Model.DonorName} (Anonymous Publicly)" : Model.DonorName)
                    </span>
                </div>

                @if (Model.BatchYear.HasValue)
                {
                    <div class="detail-row">
                        <span class="detail-label">Batch / SSC Year:</span>
                        <span class="detail-val">Batch @Model.BatchYear.Value</span>
                    </div>
                }

                <div class="detail-row">
                    <span class="detail-label">Contact Mobile:</span>
                    <span class="detail-val">@Model.DonorPhone</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.DonorEmail))
                {
                    <div class="detail-row">
                        <span class="detail-label">Email Address:</span>
                        <span class="detail-val">@Model.DonorEmail</span>
                    </div>
                }

                <div class="detail-row">
                    <span class="detail-label">Purpose / Cause:</span>
                    <span class="detail-val text-success fw-bold">@Model.DonationPurpose</span>
                </div>

                <div class="detail-row">
                    <span class="detail-label">Payment Method:</span>
                    <span class="detail-val">
                        <span class="badge bg-secondary">@Model.PaymentMode</span>
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.TransactionId))
                {
                    <div class="detail-row">
                        <span class="detail-label">TrxID / Gateway Token:</span>
                        <span class="detail-val text-monospace">@Model.TransactionId</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.GatewayFtNumber))
                {
                    <div class="detail-row">
                        <span class="detail-label">JanataPay FT Number:</span>
                        <span class="detail-val text-monospace fw-bold text-primary">@Model.GatewayFtNumber</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.SenderNumber))
                {
                    <div class="detail-row">
                        <span class="detail-label">Sender Account / Phone:</span>
                        <span class="detail-val">@Model.SenderNumber</span>
                    </div>
                }

                <div class="detail-row">
                    <span class="detail-label">Submission Date & Time:</span>
                    <span class="detail-val">@Model.CreatedAt.AddHours(6).ToString("dd MMM yyyy, hh:mm tt") (BST)</span>
                </div>

                @if (Model.ApprovedAt.HasValue)
                {
                    <div class="detail-row">
                        <span class="detail-label">Approved & Credited Date:</span>
                        <span class="detail-val text-success">@Model.ApprovedAt.Value.AddHours(6).ToString("dd MMM yyyy, hh:mm tt")</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <div class="detail-row">
                        <span class="detail-label">Donor Message:</span>
                        <span class="detail-val font-italic text-muted">"@Model.Remarks"</span>
                    </div>
                }
            </div>

            <!-- Notice box for pending -->
            @if (!isApproved)
            {
                <div class="alert alert-info d-flex align-items-center mt-3 mb-0" role="alert">
                    <i class="fas fa-info-circle fa-lg me-2"></i>
                    <div class="small">
                        Your voluntary contribution is currently being reconciled by the accounts committee. Once verified, this receipt status will automatically update to <strong>Verified & Received</strong>.
                    </div>
                </div>
            }
        </div>

        <!-- Footer -->
        <div class="receipt-footer">
            <div>
                <small class="text-muted d-block">Authorized by</small>
                <strong class="text-dark small">Alumni Reunion & Development Fund</strong>
            </div>
            @if (!string.IsNullOrEmpty(qrBase64))
            {
                <div class="text-center">
                    <img src="data:image/png;base64,@qrBase64" alt="Verify QR" style="width: 70px; height: 70px; border-radius: 6px; border: 1px solid #cbd5e1;" />
                    <span class="d-block text-muted" style="font-size: 0.65rem;">Scan to verify</span>
                </div>
            }
        </div>
    </div>

    <!-- Action Bar -->
    <div class="action-bar no-print">
        <button onclick="window.print()" class="btn btn-primary px-4 py-2 fw-semibold">
            <i class="fas fa-print me-2"></i> Print / Download Receipt
        </button>
        <a href="/" class="btn btn-outline-secondary px-4 py-2 fw-semibold">
            <i class="fas fa-home me-2"></i> Back to Home
        </a>
    </div>

</body>
</html>
