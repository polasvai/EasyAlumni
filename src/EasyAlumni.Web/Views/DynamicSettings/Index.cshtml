<!-- Hidden Delete Forms -->
<form id="deleteGuestCategoryForm" asp-controller="DynamicSettings" asp-action="DeleteGuestCategory" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteGuestCatId" />
</form>

<form id="deleteQuestionForm" asp-controller="DynamicSettings" asp-action="DeleteCustomQuestion" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteQuestionId" />
</form>

@section Scripts {
    <script>
        function openEditGuestModal(id, name, bangla, fee, rules, gender, maxAge, maxAllowed, order, isActive) {
            document.getElementById('editGuestCatId').value = id;
            document.getElementById('editGuestCatName').value = name;
            document.getElementById('editGuestCatNameBangla').value = bangla;
            document.getElementById('editGuestCatFee').value = fee;
            document.getElementById('editGuestCatRules').value = rules;
            document.getElementById('editGuestCatGender').value = gender;
            document.getElementById('editGuestCatMaxAge').value = maxAge !== null ? maxAge : '';
            document.getElementById('editGuestCatMaxAllowed').value = maxAllowed;
            document.getElementById('editGuestCatOrder').value = order;
            document.getElementById('editGuestCatIsActive').checked = isActive;
            new bootstrap.Modal(document.getElementById('editGuestCategoryModal')).show();
        }

        function confirmDeleteGuestCategory(id, name) {
            Swal.fire({
                title: 'Delete Guest Category?',
                text: 'Are you sure you want to delete or deactivate "' + name + '"?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash-alt me-1"></i> Yes, delete',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteGuestCatId').value = id;
                    document.getElementById('deleteGuestCategoryForm').submit();
                }
            });
        }

        function openEditQuestionModal(id, text, bangla, type, subText, isRequired, order, isActive) {
            document.getElementById('editQuestionId').value = id;
            document.getElementById('editQuestionText').value = text;
            document.getElementById('editQuestionTextBangla').value = bangla;
            document.getElementById('editQuestionFieldType').value = type;
            document.getElementById('editQuestionSubText').value = subText;
            document.getElementById('editQuestionRequired').checked = isRequired;
            document.getElementById('editQuestionOrder').value = order;
            document.getElementById('editQuestionIsActive').checked = isActive;
            new bootstrap.Modal(document.getElementById('editQuestionModal')).show();
        }

        function confirmDeleteQuestion(id, text) {
            Swal.fire({
                title: 'Deactivate Custom Question?',
                text: 'Are you sure you want to remove "' + text + '" from the registration form?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash-alt me-1"></i> Yes, remove',
                cancelButtonText: 'Cancel',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteQuestionId').value = id;
                    document.getElementById('deleteQuestionForm').submit();
                }
            });
        }
    </script>
}
