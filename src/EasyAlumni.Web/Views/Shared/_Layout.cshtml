@using Microsoft.AspNetCore.Identity
@using EasyAlumni.Core.Entities
@using Microsoft.EntityFrameworkCore
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject EasyAlumni.Infrastructure.Data.ApplicationDbContext DbContext

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EasyAlumni Reunion</title>
    
    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <!-- DataTables Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">

    <style>
        :root {
            --primary: #006a4e; /* Deep Forest Emerald */
            --primary-dark: #004d38;
            --primary-light: #e8f5e9;
            --secondary: #d32f2f; /* Crimson Red */
            --accent: #f59e0b; /* Amber Gold */
            --dark: #0f172a;
            --light: #f8fafc;
        }

        body {
            font-family: 'Poppins', 'Hind Siliguri', sans-serif;
            color: #334155;
            background-color: #fdfdfd;
            overflow-x: hidden;
        }

        /* Modern Navbar */
        .navbar-custom {
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(12px);
            padding: 14px 0;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.35rem;
            color: #fff !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .navbar-brand i {
            color: var(--accent);
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 500;
            padding: 8px 14px !important;
            border-radius: 6px;
            transition: all 0.2s ease;
        }

        .nav-link:hover {
            color: var(--accent) !important;
            background: rgba(255, 255, 255, 0.05);
        }

        .btn-register-nav {
            background: linear-gradient(135deg, var(--secondary), #b71c1c);
            color: #fff !important;
            font-weight: 600;
            border-radius: 50px;
            padding: 8px 22px !important;
            box-shadow: 0 4px 15px rgba(211, 47, 47, 0.4);
            transition: all 0.3s ease;
        }

        .btn-register-nav:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(211, 47, 47, 0.6);
        }

        .btn-portal-nav {
            background: linear-gradient(135deg, var(--primary), #004d38);
            color: #fff !important;
            font-weight: 600;
            border-radius: 50px;
            padding: 8px 20px !important;
            transition: all 0.3s ease;
        }

        .btn-portal-nav:hover {
            transform: translateY(-2px);
            background: #004d38;
        }

        /* Footer */
        footer.footer-custom {
            background: #0b1329;
            color: #94a3b8;
            padding: 60px 0 30px;
        }

        footer.footer-custom h5 {
            color: #fff;
            font-weight: 700;
            margin-bottom: 20px;
        }

        footer.footer-custom a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.2s;
        }

        footer.footer-custom a:hover {
            color: var(--accent);
        }

        /* Badge Pill */
        .badge-pill {
            border-radius: 50px;
            padding: 6px 14px;
            font-weight: 600;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-custom">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <span>EasyAlumni</span>
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/#home">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#schedule">Schedule</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#fees">Packages</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Committee">Committee</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#gallery">Gallery</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/#contact">Contact</a>
                    </li>
                    <li class="nav-item ms-lg-2 my-2 my-lg-0">
                        <a class="nav-link text-warning fw-semibold text-center" asp-controller="Pass" asp-action="DownloadPass">
                            <i class="fas fa-id-badge me-1"></i> ID Card
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2 my-2 my-lg-0">
                        <a class="nav-link btn-register-nav text-center" asp-controller="Enrollment" asp-action="Register">
                            Register Now
                        </a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item ms-lg-2 my-2 my-lg-0">
                            <a class="nav-link btn-portal-nav text-center" asp-controller="Admin" asp-action="Index">
                                Admin Panel
                            </a>
                        </li>
                        <li class="nav-item ms-lg-1 my-2 my-lg-0">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                <button type="submit" class="nav-link btn btn-link text-white-50 text-decoration-none px-2">
                                    Sign Out
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-2 my-2 my-lg-0">
                            <a class="nav-link btn-portal-nav text-center" asp-controller="Account" asp-action="Login">
                                Login
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main role="main">
        @RenderBody()
    </main>

    @{
        var footerSettings = await DbContext.SystemSettings
            .Where(s => s.SettingKey.StartsWith("Footer") || s.SettingKey.StartsWith("Contact"))
            .ToDictionaryAsync(s => s.SettingKey, s => s.SettingValue);

        var footerAbout = footerSettings.GetValueOrDefault("FooterAboutText", "The ultimate event and alumni community management platform. Connecting alumni, celebrating lifelong friendships, and organizing grand reunions seamlessly.");
        var footerFb = footerSettings.GetValueOrDefault("FooterFacebookUrl", "#");
        var footerYt = footerSettings.GetValueOrDefault("FooterYoutubeUrl", "#");
        var footerWa = footerSettings.GetValueOrDefault("FooterWhatsappUrl", "#");
        var footerCopyright = footerSettings.GetValueOrDefault("FooterCopyright", $"© {DateTime.UtcNow.Year} EasyAlumni Association. All rights reserved.");
        var footerTagline = footerSettings.GetValueOrDefault("FooterTagline", "Designed for School, College & University Grand Reunions");
        var footerMadeWith = footerSettings.GetValueOrDefault("FooterMadeWith", "Made with ❤️");
        var footerHotline = footerSettings.GetValueOrDefault("ContactHotline", "+880 1700-000000");
        var footerEmail = footerSettings.GetValueOrDefault("ContactEmail", "reunion@easyalumni.com");
    }

    <!-- Footer -->
    <footer class="footer-custom">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5><i class="fas fa-graduation-cap text-warning me-2"></i> EasyAlumni Reunion</h5>
                    <p class="small">
                        @footerAbout
                    </p>
                    <p class="small mb-0 text-white-50">
                        @Html.Raw(footerMadeWith.Replace("❤️", "<i class=\"fas fa-heart text-danger\"></i>"))
                    </p>
                </div>
                <div class="col-lg-2 col-6">
                    <h5>Quick Links</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="/#about">About Event</a></li>
                        <li class="mb-2"><a href="/#schedule">Program Schedule</a></li>
                        <li class="mb-2"><a href="/#fees">Registration Packages</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Committee">Organizing Committee</a></li>
                        <li class="mb-2"><a asp-controller="Enrollment" asp-action="Register">Alumni Enrollment</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-6">
                    <h5>Portals</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Account" asp-action="Login">Admin &amp; Staff Login</a></li>
                        <li class="mb-2"><a asp-controller="Kiosk" asp-action="Index">Volunteer Check-in Kiosk</a></li>
                        <li class="mb-2"><a asp-controller="Admin" asp-action="Index">Administrative Dashboard</a></li>
                        <li class="mb-2"><a href="/#contact">Help &amp; Support</a></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h5>Contact &amp; Hotline</h5>
                    <p class="small mb-1"><i class="fas fa-phone-alt text-warning me-2"></i> Hotline: @footerHotline</p>
                    @if (!string.IsNullOrWhiteSpace(footerWa) && footerWa != "#")
                    {
                        <p class="small mb-1"><i class="fab fa-whatsapp text-success me-2"></i> WhatsApp: <a href="@footerWa" target="_blank" rel="noopener noreferrer" class="text-white text-decoration-underline">Direct Chat</a></p>
                    }
                    <p class="small mb-3"><i class="fas fa-envelope text-info me-2"></i> @footerEmail</p>
                    <div class="d-flex gap-2">
                        @if (!string.IsNullOrWhiteSpace(footerFb) && footerFb != "#")
                        {
                            <a href="@footerFb" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(footerYt) && footerYt != "#")
                        {
                            <a href="@footerYt" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;" title="YouTube"><i class="fab fa-youtube"></i></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(footerWa) && footerWa != "#")
                        {
                            <a href="@footerWa" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;" title="WhatsApp"><i class="fab fa-whatsapp"></i></a>
                        }
                    </div>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255,255,255,0.1)">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start small">
                    @footerCopyright
                </div>
                <div class="col-md-6 text-center text-md-end small">
                    <span>@footerTagline</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
