@model EasyAlumni.Core.Entities.NoticePost
@{
    ViewData["Title"] = Model.Title;
}

<div class="bg-dark text-white py-5" style="background: linear-gradient(135deg, #0f172a 0%, #004d38 100%) !important; padding-top: 120px !important;">
    <div class="container text-center">
        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-3">@Model.Category</span>
        <h1 class="fw-bold">@Model.Title</h1>
        <p class="small opacity-75"><i class="fas fa-calendar-alt me-1"></i> Published: @Model.PublishDate.ToString("MMMM dd, yyyy")</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <div class="lead text-dark mb-4">
                    @Html.Raw(Model.ContentHtml)
                </div>

                @if (!string.IsNullOrEmpty(Model.AttachmentPath))
                {
                    <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between mt-4">
                        <div>
                            <i class="fas fa-paperclip text-danger me-2 fa-lg"></i>
                            <strong>Official Circular / Attachment</strong>
                        </div>
                        <a href="@Model.AttachmentPath" target="_blank" class="btn btn-sm btn-primary rounded-pill px-3">
                            <i class="fas fa-download me-1"></i> Download
                        </a>
                    </div>
                }

                <div class="mt-5 pt-3 border-top d-flex justify-content-between align-items-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                        <i class="fas fa-arrow-left me-1"></i> Back to Home
                    </a>
                    <a asp-controller="Enrollment" asp-action="Register" class="btn btn-danger rounded-pill">
                        <i class="fas fa-user-plus me-1"></i> Register for Reunion
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
