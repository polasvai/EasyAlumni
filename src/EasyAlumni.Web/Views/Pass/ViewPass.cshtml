@model EasyAlumni.Core.Entities.EventRegistration
@{
    Layout = null;
    ViewData["Title"] = $"Digital Pass - {Model.RegistrationNo}";
    var profile = Model.AlumniProfile;
    var ev = Model.ReunionEvent;
    var pkg = Model.RegistrationPackage;
    var isApproved = Model.Status == EasyAlumni.Core.Enums.RegistrationStatus.Approved;
    var successfulPayment = Model.Payments?.OrderByDescending(p => p.SubmittedAt).FirstOrDefault(p => p.Status == EasyAlumni.Core.Enums.PaymentStatus.Approved) 
                            ?? Model.Payments?.OrderByDescending(p => p.SubmittedAt).FirstOrDefault();

    var dynamicGuests = Model.Guests?.ToList() ?? new List<EasyAlumni.Core.Entities.RegistrationGuest>();
    var totalHeads = 1 + (dynamicGuests.Any() ? dynamicGuests.Count : (Model.SpouseCount + Model.ChildCount + Model.GuestCount));

    // Dynamic Gifts: either from attendee's gift size choices or package gift items
    var giftChoices = Model.GiftChoices?.ToList() ?? new List<EasyAlumni.Core.Entities.RegistrationGiftChoice>();
    var packageGifts = pkg?.PackageGiftItems?.Select(pg => pg.GiftItem).Where(g => g != null).ToList() ?? new List<EasyAlumni.Core.Entities.GiftItem?>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Entry Pass - @Model.RegistrationNo</title>
    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', 'Hind Siliguri', sans-serif;
            background-color: #f1f5f9;
            padding: 30px 15px;
            color: #1e293b;
        }

        .pass-container {
            max-width: 760px;
            margin: 0 auto;
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid #e2e8f0;
            position: relative;
        }

        .pass-header {
            background: linear-gradient(135deg, #0f172a 0%, #004d38 100%);
            color: #fff;
            padding: 24px 28px;
            text-align: center;
            position: relative;
        }

        .pass-badge {
            background: #f59e0b;
            color: #0f172a;
            padding: 4px 16px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .package-ribbon {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(4px);
            color: #fff;
            padding: 4px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 6px;
        }

        .alumni-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #fff;
            box-shadow: 0 6px 20px rgba(0,0,0,0.15);
            background: #e2e8f0;
        }

        .qr-code-img {
            width: 150px;
            height: 150px;
            border: 2px solid #cbd5e1;
            border-radius: 12px;
            padding: 6px;
            background: #fff;
        }

        .section-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 20px;
        }

        .section-title {
            font-size: 0.95rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            color: #0f172a;
        }

        .ticket-code-badge {
            font-family: monospace;
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: 2px;
            background: #f1f5f9;
            color: #006a4e;
            padding: 6px 16px;
            border-radius: 8px;
            display: inline-block;
            border: 1px dashed #006a4e;
        }

        .item-tile {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 12px;
            height: 100%;
            text-align: center;
            transition: transform 0.15s ease-in-out;
        }

        .watermark-pending {
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 3.5rem;
            font-weight: 900;
            color: rgba(220, 38, 38, 0.12);
            text-transform: uppercase;
            letter-spacing: 6px;
            pointer-events: none;
            z-index: 5;
            white-space: nowrap;
        }

        .pill-inclusion {
            font-size: 0.75rem;
            padding: 3px 10px;
            border-radius: 30px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .pass-container {
                box-shadow: none;
                border: 1px solid #94a3b8;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- Action Buttons -->
    <div class="text-center mb-4 no-print">
        <a href="/" class="btn btn-outline-secondary rounded-pill px-4 me-2">
            <i class="fas fa-arrow-left me-1"></i> Home
        </a>
        <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm" onclick="window.print()">
            <i class="fas fa-print me-1"></i> Print / Save as PDF
        </button>
    </div>

    <div class="pass-container">
        @if (!isApproved)
        {
            <div class="watermark-pending">PAYMENT PENDING</div>
        }

        <!-- Header -->
        <div class="pass-header">
            <span class="pass-badge"><i class="fas fa-star me-1"></i> Official Digital Entry Pass</span>
            <h3 class="fw-bold mb-1">@(ev?.EventTitle ?? "Grand Alumni Reunion 2026")</h3>
            @if (!string.IsNullOrEmpty(ev?.TitleBangla))
            {
                <h6 class="text-warning mb-2 fw-semibold">@ev.TitleBangla</h6>
            }
            <p class="small opacity-90 mb-2">
                <i class="fas fa-calendar-alt me-1"></i> <strong>@(ev?.EventDate.ToString("dddd, MMMM dd, yyyy") ?? "Dec 25, 2026")</strong> &nbsp;|&nbsp;
                <i class="fas fa-map-marker-alt me-1"></i> <strong>@(ev?.VenueName ?? "Main Auditorium")</strong>
            </p>

            @if (pkg != null)
            {
                <div>
                    <span class="package-ribbon">
                        <i class="fas fa-box-open text-warning"></i> Package: <strong>@pkg.PackageName</strong>
                        @if (!string.IsNullOrWhiteSpace(pkg.PackageNameBangla))
                        {
                            <span>(@pkg.PackageNameBangla)</span>
                        }
                    </span>
                </div>
            }
        </div>

        <div class="p-4 p-md-4">
            <!-- Attendee & QR Profile Row -->
            <div class="row align-items-center g-3 mb-4">
                <!-- Alumnus Avatar & Basic Details -->
                <div class="col-sm-4 text-center">
                    <img src="@(string.IsNullOrEmpty(profile?.RecentPhotoPath) ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(profile?.NameEnglish ?? "Alumni") + "&background=006a4e&color=fff&size=256" : profile.RecentPhotoPath)"
                         alt="Alumnus Photo" class="alumni-avatar mb-2" />
                    <h5 class="fw-bold text-dark mb-0">@profile?.NameEnglish</h5>
                    <div class="text-muted small">@profile?.NameBangla</div>
                    <div class="mt-1 d-flex justify-content-center gap-1 flex-wrap">
                        <span class="badge bg-dark rounded-pill px-2.5 py-1">Batch @profile?.PassingYear</span>
                        @if (!string.IsNullOrEmpty(profile?.BloodGroup))
                        {
                            <span class="badge bg-danger rounded-pill px-2 py-1">@profile.BloodGroup</span>
                        }
                    </div>
                </div>

                <!-- QR Code & Registration Number -->
                <div class="col-sm-8 text-center text-sm-start ps-sm-3">
                    <div class="d-flex flex-column flex-sm-row align-items-center gap-3">
                        <div class="text-center">
                            <img src="@Model.QrCodeBase64" alt="Entry QR Code" class="qr-code-img shadow-sm" />
                            <small class="text-muted d-block mt-1 font-monospace" style="font-size: 0.75rem;">Gate Security QR</small>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold d-block">Ticket / Reg. Number</span>
                            <div class="ticket-code-badge mb-2">@Model.RegistrationNo</div>

                            <div class="mb-2">
                                @if (isApproved)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i> VERIFIED &amp; APPROVED</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2"><i class="fas fa-hourglass-half me-1"></i> PENDING VERIFICATION</span>
                                }
                            </div>

                            @if (Model.IsKitDistributed)
                            {
                                <div class="badge bg-primary rounded-pill px-3 py-1.5 small">
                                    <i class="fas fa-box-check me-1"></i> Kit Collected at @Model.KitDistributedAt?.ToString("hh:mm tt, dd MMM")
                                </div>
                            }
                            else
                            {
                                <div class="badge bg-light text-secondary border rounded-pill px-2.5 py-1 small">
                                    <i class="fas fa-box me-1"></i> Kit Status: Uncollected
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dynamic Package Inclusions & Amenities -->
            @if (pkg != null)
            {
                <div class="section-card">
                    <div class="section-title text-success">
                        <i class="fas fa-certificate text-warning"></i> Package Amenities &amp; Entitlements
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        @if (pkg.IncludesFood)
                        {
                            <span class="pill-inclusion bg-success-subtle text-success border border-success-subtle">
                                <i class="fas fa-utensils"></i> Grand Food &amp; Catering Included
                            </span>
                        }
                        @if (pkg.IncludesKitBag)
                        {
                            <span class="pill-inclusion bg-primary-subtle text-primary border border-primary-subtle">
                                <i class="fas fa-shopping-bag"></i> Official Kit Bag &amp; Souvenir
                            </span>
                        }
                        @if (pkg.IncludesRaffle)
                        {
                            <span class="pill-inclusion bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                <i class="fas fa-ticket-alt"></i> Mega Raffle Draw Entry
                            </span>
                        }
                        @if (pkg.IncludedGuests > 0)
                        {
                            <span class="pill-inclusion bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">
                                <i class="fas fa-user-friends"></i> @pkg.IncludedGuests Guest(s) Included in Package
                            </span>
                        }
                    </div>
                </div>
            }

            <!-- Dynamic Authorized Merchandise & Gift Items -->
            <div class="section-card">
                <div class="section-title text-primary">
                    <i class="fas fa-gift text-danger"></i> Official Gift Items &amp; Merchandise Allocation
                </div>

                <div class="row g-2 text-center">
                    <!-- Dynamic Gift Items / Choices -->
                    @if (giftChoices.Any())
                    {
                        foreach (var gc in giftChoices)
                        {
                            var itemName = gc.GiftItem?.ItemName ?? "Gift Item";
                            var sizeOrQty = !string.IsNullOrWhiteSpace(gc.SelectedSize) ? gc.SelectedSize : "1 Unit";
                            <div class="col-sm-3 col-6">
                                <div class="item-tile">
                                    <small class="text-muted d-block fw-semibold text-truncate" title="@itemName">@itemName</small>
                                    <h5 class="fw-bold text-dark mb-0 mt-1">@sizeOrQty</h5>
                                    <span class="badge bg-success-subtle text-success rounded-pill mt-1" style="font-size: 0.7rem;">Included</span>
                                </div>
                            </div>
                        }
                    }
                    else if (packageGifts.Any())
                    {
                        foreach (var g in packageGifts)
                        {
                            if (g == null || g.ItemName.Contains("T-Shirt", StringComparison.OrdinalIgnoreCase)) continue;
                            <div class="col-sm-3 col-6">
                                <div class="item-tile">
                                    <small class="text-muted d-block fw-semibold text-truncate" title="@g.ItemName">@g.ItemName</small>
                                    <h5 class="fw-bold text-dark mb-0 mt-1">1 Unit</h5>
                                    <span class="badge bg-success-subtle text-success rounded-pill mt-1" style="font-size: 0.7rem;">Included</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Fallback standard kit items if package gift relations are unassigned -->
                        <div class="col-sm-3 col-6">
                            <div class="item-tile">
                                <small class="text-muted d-block fw-semibold">Gift Hamper</small>
                                <h4 class="fw-bold text-dark mb-0 mt-1">1 Unit</h4>
                                <span class="badge bg-success-subtle text-success rounded-pill mt-1" style="font-size: 0.7rem;">Included</span>
                            </div>
                        </div>
                        <div class="col-sm-3 col-6">
                            <div class="item-tile">
                                <small class="text-muted d-block fw-semibold">Backpack &amp; ID</small>
                                <h4 class="fw-bold text-dark mb-0 mt-1">1 Unit</h4>
                                <span class="badge bg-success-subtle text-success rounded-pill mt-1" style="font-size: 0.7rem;">Included</span>
                            </div>
                        </div>
                    }

                    <!-- Total Heads & Meals -->
                    <div class="col-sm-3 col-6">
                        <div class="item-tile">
                            <small class="text-muted d-block fw-semibold">Total Entry Heads</small>
                            <h4 class="fw-bold text-success mb-0 mt-1">@totalHeads Persons</h4>
                            <span class="badge bg-info-subtle text-info rounded-pill mt-1" style="font-size: 0.7rem;">Gate Access</span>
                        </div>
                    </div>
                </div>

                <!-- Dynamic Guest Breakdown -->
                <div class="mt-3 pt-3 border-top small text-muted">
                    <div class="d-flex justify-content-between flex-wrap align-items-center gap-2">
                        <div>
                            <strong><i class="fas fa-users text-secondary me-1"></i> Attendance Breakdown:</strong>
                            Self (1)
                            @if (dynamicGuests.Any())
                            {
                                foreach (var g in dynamicGuests)
                                {
                                    var catName = g.GuestCategory?.CategoryName ?? "Guest";
                                    var details = !string.IsNullOrWhiteSpace(g.GuestName) ? $" ({g.GuestName})" : "";
                                    <span> + @catName@details</span>
                                }
                            }
                            else
                            {
                                if (Model.SpouseCount > 0) { <span> + Spouse (@Model.SpouseCount)</span> }
                                if (Model.ChildCount > 0) { <span> + Child (@Model.ChildCount)</span> }
                                if (Model.GuestCount > 0) { <span> + Guests (@Model.GuestCount)</span> }
                            }
                        </div>
                        <div>
                            <i class="fas fa-phone-alt me-1"></i> @profile?.ContactNumber
                        </div>
                    </div>
                </div>
            </div>

            <!-- Verified Payment & Transaction Information -->
            <div class="section-card">
                <div class="section-title text-secondary">
                    <i class="fas fa-receipt text-success"></i> Payment &amp; Gateway Details
                </div>
                <div class="row g-2 small">
                    <div class="col-sm-4 col-6">
                        <span class="text-muted d-block">Payment Method:</span>
                        <strong class="text-dark">
                            <i class="fas fa-university text-primary me-1"></i>
                            @(successfulPayment?.PaymentMode.ToString() ?? "Online Payment")
                        </strong>
                    </div>
                    <div class="col-sm-4 col-6">
                        <span class="text-muted d-block">Transaction / FT No:</span>
                        <span class="font-monospace fw-bold text-dark">
                            @(string.IsNullOrEmpty(successfulPayment?.GatewayFtNumber) ? (successfulPayment?.TransactionId ?? "N/A") : successfulPayment.GatewayFtNumber)
                        </span>
                    </div>
                    <div class="col-sm-4 col-12">
                        <span class="text-muted d-block">Total Paid Amount:</span>
                        <span class="text-success fw-bold fs-6">৳ @Model.PaidAmount.ToString("N0") BDT</span>
                        @if (successfulPayment?.ApprovedAt.HasValue == true)
                        {
                            <small class="text-muted d-block">Confirmed on @successfulPayment.ApprovedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</small>
                        }
                    </div>
                </div>
            </div>

            <!-- Gate Instructions -->
            <div class="p-3 bg-light rounded-3 border small text-muted">
                <h6 class="fw-bold text-dark mb-1"><i class="fas fa-shield-alt text-primary me-1"></i> Gate Security &amp; Kit Collection Guidelines:</h6>
                <ul class="mb-0 ps-3">
                    <li>Display this QR code on your phone screen or carry a printed copy for gate check-in.</li>
                    <li>Kit distribution volunteers will scan this code to issue your kit bag, gift hamper, and event tokens.</li>
                    <li>This digital pass is uniquely signed and valid for <strong>@totalHeads person(s)</strong>.</li>
                </ul>
            </div>
        </div>

        <div class="card-footer p-3 bg-light text-center small text-muted border-top">
            &copy; @DateTime.UtcNow.Year EasyAlumni Reunion Management System &bull; Issued for: @profile?.NameEnglish (@Model.RegistrationNo)
        </div>
    </div>

</body>
</html>
