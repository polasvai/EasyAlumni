@model EasyAlumni.Core.Entities.EventRegistration
@{
    ViewData["Title"] = $"Digital Pass - {Model.RegistrationNo}";
    var profile = Model.AlumniProfile;
    var ev = Model.ReunionEvent;
    var totalHeads = 1 + Model.SpouseCount + Model.ChildCount + Model.GuestCount;
    var isApproved = Model.Status == EasyAlumni.Core.Enums.RegistrationStatus.Approved;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Digital Entry Pass - @Model.RegistrationNo</title>
    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', 'Hind Siliguri', sans-serif;
            background-color: #f1f5f9;
            padding: 40px 15px;
            color: #1e293b;
        }

        .pass-container {
            max-width: 720px;
            margin: 0 auto;
            background: #fff;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
            overflow: hidden;
            border: 2px solid #e2e8f0;
            position: relative;
        }

        .pass-header {
            background: linear-gradient(135deg, #0f172a 0%, #004d38 100%);
            color: #fff;
            padding: 30px;
            text-align: center;
            position: relative;
        }

        .pass-badge {
            background: #f59e0b;
            color: #0f172a;
            padding: 4px 16px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.8rem;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 8px;
        }

        .alumni-avatar {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #fff;
            box-shadow: 0 8px 25px rgba(0,0,0,0.25);
            background: #e2e8f0;
        }

        .qr-code-img {
            width: 170px;
            height: 170px;
            border: 2px solid #cbd5e1;
            border-radius: 12px;
            padding: 6px;
            background: #fff;
        }

        .entitlement-box {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 20px;
        }

        .ticket-code-badge {
            font-family: monospace;
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: 2px;
            background: #f1f5f9;
            color: #006a4e;
            padding: 8px 18px;
            border-radius: 8px;
            display: inline-block;
            border: 1px dashed #006a4e;
        }

        .watermark-pending {
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-30deg);
            font-size: 4rem;
            font-weight: 900;
            color: rgba(220, 38, 38, 0.15);
            text-transform: uppercase;
            letter-spacing: 6px;
            pointer-events: none;
            z-index: 5;
            white-space: nowrap;
        }

        @@media print {
            body {
                background: #fff;
                padding: 0;
            }
            .pass-container {
                box-shadow: none;
                border: 1px solid #ccc;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- Action Buttons -->
    <div class="text-center mb-4 no-print">
        <a href="/" class="btn btn-outline-secondary rounded-pill px-4 me-2">
            <i class="fas fa-arrow-left me-1"></i> Back
        </a>
        <button type="button" class="btn btn-success rounded-pill px-4 shadow" onclick="window.print()">
            <i class="fas fa-print me-1"></i> Print / Save as PDF
        </button>
    </div>

    <div class="pass-container">
        @if (!isApproved)
        {
            <div class="watermark-pending">PAYMENT PENDING</div>
        }

        <!-- Header -->
        <div class="pass-header">
            <span class="pass-badge"><i class="fas fa-star me-1"></i> Official Digital Entry Pass</span>
            <h2 class="fw-bold mb-1">@(ev?.EventTitle ?? "Grand Alumni Reunion 2026")</h2>
            <h5 class="text-warning mb-2">@(ev?.TitleBangla ?? "রাজশাহী মডেল স্কুল এন্ড কলেজ পুনর্মিলনী")</h5>
            <p class="small opacity-80 mb-0">
                <i class="fas fa-calendar-alt me-1"></i> Date: <strong>@(ev?.EventDate.ToString("MMMM dd, yyyy") ?? "Dec 25, 2026")</strong> &nbsp;|&nbsp;
                <i class="fas fa-map-marker-alt me-1"></i> <strong>@(ev?.VenueName ?? "College Auditorium")</strong>
            </p>
        </div>

        <div class="p-4 p-md-5">
            <div class="row align-items-center g-4 mb-4">
                <!-- Alumnus Avatar -->
                <div class="col-sm-4 text-center">
                    <img src="@(string.IsNullOrEmpty(profile?.RecentPhotoPath) ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(profile?.NameEnglish ?? "Alumni") + "&background=006a4e&color=fff&size=256" : profile.RecentPhotoPath)"
                         alt="Alumnus Photo" class="alumni-avatar mb-2" />
                    <h5 class="fw-bold text-dark mb-0">@profile?.NameEnglish</h5>
                    <div class="text-muted small">@profile?.NameBangla</div>
                    <span class="badge bg-dark rounded-pill px-3 py-1 mt-1">Batch @profile?.PassingYear</span>
                    @if (!string.IsNullOrEmpty(profile?.BloodGroup))
                    {
                        <span class="badge bg-danger rounded-pill px-2 py-1 mt-1">@profile.BloodGroup</span>
                    }
                </div>

                <!-- QR Code & Ticket Code -->
                <div class="col-sm-8 text-center text-sm-start">
                    <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
                        <div class="text-center">
                            <img src="@Model.QrCodeBase64" alt="Entry QR Code" class="qr-code-img shadow-sm" />
                            <small class="text-muted d-block mt-1">Gate Verification QR</small>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase d-block">Ticket Registration Number</span>
                            <div class="ticket-code-badge mb-3">@Model.RegistrationNo</div>

                            <div class="mb-2">
                                <span class="text-muted small d-block">Pass Status:</span>
                                @if (isApproved)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2"><i class="fas fa-check-circle me-1"></i> VERIFIED &amp; APPROVED</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2"><i class="fas fa-hourglass-half me-1"></i> PENDING APPROVAL</span>
                                }
                            </div>

                            @if (Model.IsKitDistributed)
                            {
                                <span class="badge bg-primary rounded-pill px-3 py-1 small">
                                    <i class="fas fa-box-check me-1"></i> Kit Collected at @Model.KitDistributedAt?.ToString("hh:mm tt")
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Entitlements & Kit Details -->
            <div class="entitlement-box mb-4">
                <h6 class="fw-bold text-success mb-3"><i class="fas fa-gift text-warning me-2"></i> Authorized Event Entitlements &amp; Merchandise:</h6>
                <div class="row g-3 text-center">
                    <div class="col-sm-3 col-6">
                        <div class="p-2 bg-white rounded border">
                            <small class="text-muted d-block">T-Shirt Size</small>
                            <h4 class="fw-bold text-primary mb-0">@Model.TShirtSize</h4>
                        </div>
                    </div>
                    <div class="col-sm-3 col-6">
                        <div class="p-2 bg-white rounded border">
                            <small class="text-muted d-block">Gift Hamper</small>
                            <h4 class="fw-bold text-dark mb-0">1 Unit</h4>
                        </div>
                    </div>
                    <div class="col-sm-3 col-6">
                        <div class="p-2 bg-white rounded border">
                            <small class="text-muted d-block">Backpack &amp; ID</small>
                            <h4 class="fw-bold text-dark mb-0">1 Unit</h4>
                        </div>
                    </div>
                    <div class="col-sm-3 col-6">
                        <div class="p-2 bg-white rounded border">
                            <small class="text-muted d-block">Total Meals / Heads</small>
                            <h4 class="fw-bold text-success mb-0">@totalHeads Heads</h4>
                        </div>
                    </div>
                </div>

                <div class="mt-3 pt-3 border-top small text-muted d-flex justify-content-between flex-wrap gap-2">
                    <span><strong>Breakdown:</strong> Self (1) + Spouse (@Model.SpouseCount) + Children (@Model.ChildCount) + Guests (@Model.GuestCount)</span>
                    <span><strong>Contact:</strong> @profile?.ContactNumber</span>
                </div>
            </div>

            <!-- Gate Instructions -->
            <div class="p-3 bg-light rounded-3 border small text-muted">
                <h6 class="fw-bold text-dark mb-1"><i class="fas fa-info-circle text-primary me-1"></i> Important Instructions:</h6>
                <ul class="mb-0 ps-3">
                    <li>Please display this QR code on your phone screen or bring a printed copy to the reception gate.</li>
                    <li>Kit distribution volunteers will scan this code to issue your official T-shirt size <strong>(@Model.TShirtSize)</strong>, gift hamper, and meal tokens.</li>
                    <li>This QR code is non-transferable and can only be scanned once for kit collection.</li>
                </ul>
            </div>
        </div>

        <div class="card-footer p-3 bg-light text-center small text-muted border-top">
            &copy; @DateTime.UtcNow.Year EasyAlumni Reunion Management System &bull; Issued for: @profile?.NameEnglish (@Model.RegistrationNo)
        </div>
    </div>

</body>
</html>
