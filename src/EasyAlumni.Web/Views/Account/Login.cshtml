@model EasyAlumni.Web.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Account Login";
    Layout = "_Layout";
}

<div class="bg-dark text-white py-5" style="background: linear-gradient(135deg, #0f172a 0%, #004d38 100%) !important; padding-top: 120px !important;">
    <div class="container text-center">
        <h1 class="fw-bold">Sign In to EasyAlumni</h1>
        <p class="lead opacity-80">Access Administrative Dashboard, Accounts &amp; Volunteer Desks</p>
    </div>
</div>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-block bg-success bg-opacity-10 text-success p-3 rounded-circle mb-3">
                        <i class="fas fa-user-lock fa-2x"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Staff &amp; Admin Login</h3>
                    <p class="text-muted small">Enter your authorized administrative credentials</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 py-2 small mb-3">
                        <div asp-validation-summary="All" class="text-danger mb-0"></div>
                    </div>
                }

                <form method="post" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email or Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email or username" required autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Enter your password" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label class="form-check-label small text-muted" asp-for="RememberMe">Remember me</label>
                        </div>
                        <a href="/Enrollment/Register" class="small text-success fw-semibold text-decoration-none">Alumni Register?</a>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow">
                        <i class="fas fa-sign-in-alt me-2"></i> Log In
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
