@model List<EasyAlumni.Core.Entities.CashEntry>
@{
    ViewData["Title"] = "Reunion Accounting";
    Layout = "_AdminLayout";
    var budgetHeads = (List<EasyAlumni.Core.Entities.BudgetHead>)ViewBag.BudgetHeads;
    var accountHeads = (List<EasyAlumni.Core.Entities.AccountHead>)ViewBag.AccountHeads;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">Reunion Accounting &amp; Cash Book</h2>
        <p class="text-muted small mb-0">Automated ticket revenues, expense vouchers, and budget variance tracking</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addVoucherModal">
            + Add Cash Voucher
        </button>
        <a asp-controller="Reports" asp-action="FinancialStatement" class="btn btn-outline-secondary rounded-pill px-3">
            Financial Statement
        </a>
    </div>
</div>

<!-- Financial Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 border-start border-4 border-success bg-white">
            <span class="text-muted small text-uppercase fw-bold">Total Revenue Inflow</span>
            <h3 class="fw-bold text-success mb-1 mt-1">৳ @(((decimal)ViewBag.TotalIncome).ToString("N0"))</h3>
            <small class="text-muted">Ticket collections &amp; Sponsorships</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 border-start border-4 border-danger bg-white">
            <span class="text-muted small text-uppercase fw-bold">Total Outflow (Expenses)</span>
            <h3 class="fw-bold text-danger mb-1 mt-1">৳ @(((decimal)ViewBag.TotalExpense).ToString("N0"))</h3>
            <small class="text-muted">Direct vouchers &amp; vendor bills</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 border-start border-4 border-primary bg-white">
            <span class="text-muted small text-uppercase fw-bold">Net Cash in Hand</span>
            <h3 class="fw-bold @(((decimal)ViewBag.NetBalance) >= 0 ? "text-primary" : "text-danger") mb-1 mt-1">
                ৳ @(((decimal)ViewBag.NetBalance).ToString("N0"))
            </h3>
            <small class="text-muted">Current available closing balance</small>
        </div>
    </div>
</div>

<!-- Budget vs Actual Variance Table -->
<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold text-dark mb-0">Budget vs. Actual Expenditure Variance</h5>
        <small class="text-muted">Categorized budget heads</small>
    </div>
    <div class="table-responsive p-3">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th>Budget Head</th>
                    <th class="text-end">Allocated Budget</th>
                    <th class="text-end">Actual Spent</th>
                    <th class="text-end">Variance / Remaining</th>
                    <th style="width: 180px;">% Utilized</th>
                    <th class="text-center" style="width: 90px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bh in budgetHeads)
                {
                    var remaining = bh.AllocatedAmount - bh.ActualSpent;
                    var pct = bh.AllocatedAmount > 0 ? (bh.ActualSpent / bh.AllocatedAmount) * 100 : 0;
                    <tr>
                        <td><strong>@bh.HeadName</strong></td>
                        <td class="text-end">৳ @bh.AllocatedAmount.ToString("N0")</td>
                        <td class="text-end text-danger fw-bold">৳ @bh.ActualSpent.ToString("N0")</td>
                        <td class="text-end @(remaining >= 0 ? "text-success" : "text-danger") fw-bold">
                            ৳ @remaining.ToString("N0")
                        </td>
                        <td>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @(pct > 100 ? "bg-danger" : pct > 80 ? "bg-warning" : "bg-success")"
                                     role="progressbar" style="width: @Math.Min(pct, 100)%"></div>
                            </div>
                            <small class="text-muted">@pct.ToString("F1")%</small>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-0"
                                    onclick="openBudgetModal('@bh.Id', '@bh.HeadName', '@bh.AllocatedAmount')">
                                Adjust
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Recent Cash Entries (Cash Book) -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold text-dark mb-0">Recent Cash Entries (Cash Book Ledger)</h5>
        <small class="text-muted">Showing latest 30 transactions</small>
    </div>
    <div class="table-responsive p-0">
        <table class="table table-hover align-middle mb-0" id="cashTable">
            <thead class="table-light small text-uppercase">
                <tr>
                    <th class="ps-3">Voucher No</th>
                    <th>Date</th>
                    <th>Account Head</th>
                    <th>Type</th>
                    <th>Mode</th>
                    <th>Description</th>
                    <th class="text-end">Amount</th>
                    <th class="text-center">Slip</th>
                    <th class="text-end pe-4" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model)
                {
                    var isIncome = entry.AccountHead?.Type == EasyAlumni.Core.Enums.AccountHeadType.Income;
                    <tr>
                        <td class="ps-3"><span class="badge bg-light text-dark border fw-bold">@entry.VoucherNumber</span></td>
                        <td><small class="text-muted">@entry.EntryDate.ToString("MMM dd, yyyy")</small></td>
                        <td><strong>@entry.AccountHead?.HeadName</strong></td>
                        <td>
                            @if (isIncome)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success fw-semibold">Income</span>
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold">Expense</span>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@entry.PaymentMode</span></td>
                        <td><small class="text-muted">@entry.Description</small></td>
                        <td class="text-end">
                            <strong class="@(isIncome ? "text-success" : "text-danger") fs-6">
                                @(isIncome ? "+ " : "- ") ৳ @entry.Amount.ToString("N0")
                            </strong>
                        </td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(entry.ReceiptAttachmentPath))
                            {
                                <a href="@entry.ReceiptAttachmentPath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0" title="View Document">
                                    Slip
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">-</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-0"
                                        onclick="openEditVoucherModal('@entry.Id', '@entry.VoucherNumber', '@entry.AccountHeadId', '@entry.Amount', '@entry.PaymentMode', '@(entry.Description?.Replace("'", "\\'"))')"
                                        title="Edit Entry">
                                    Edit
                                </button>
                                <form asp-controller="Accounting" asp-action="DeleteVoucher" method="post" class="d-inline m-0"
                                      onsubmit="return confirm('Are you sure you want to delete voucher @entry.VoucherNumber for ৳ @entry.Amount.ToString("N0")?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@entry.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-0" title="Delete Entry">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Voucher Modal -->
<div class="modal fade" id="addVoucherModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="Accounting" asp-action="AddVoucher" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">Add Cash Voucher</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Account Head <span class="text-danger">*</span></label>
                        <select name="accountHeadId" class="form-select" required>
                            <option value="">-- Select Account Head --</option>
                            <optgroup label="Income Heads">
                                @foreach (var h in accountHeads.Where(x => x.Type == EasyAlumni.Core.Enums.AccountHeadType.Income))
                                {
                                    <option value="@h.Id">@h.HeadName</option>
                                }
                            </optgroup>
                            <optgroup label="Expense Heads">
                                @foreach (var h in accountHeads.Where(x => x.Type == EasyAlumni.Core.Enums.AccountHeadType.Expense))
                                {
                                    <option value="@h.Id">@h.HeadName</option>
                                }
                            </optgroup>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount (BDT) <span class="text-danger">*</span></label>
                        <input type="number" step="1" name="amount" class="form-control" placeholder="e.g. 5000" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Mode</label>
                        <select name="paymentMode" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="bKash">bKash</option>
                            <option value="Nagad">Nagad</option>
                            <option value="Rocket">Rocket</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Link to Budget Line (Optional for Expenses)</label>
                        <select name="budgetHeadId" class="form-select">
                            <option value="">-- None / General Expense --</option>
                            @foreach (var bh in budgetHeads)
                            {
                                <option value="@bh.Id">@bh.HeadName (Allocated: ৳@bh.AllocatedAmount.ToString("N0"))</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description / Purpose</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="e.g. Advance paid for sound system"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Receipt / Bill Attachment (Optional)</label>
                        <input type="file" name="receiptFile" class="form-control" accept="image/*,application/pdf" />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Post Voucher</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Voucher Modal -->
<div class="modal fade" id="editVoucherModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="Accounting" asp-action="EditVoucher" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editVoucherId" />
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold">Edit Voucher: <span id="editVoucherNumber" class="text-success"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Account Head <span class="text-danger">*</span></label>
                        <select name="accountHeadId" id="editVoucherHeadId" class="form-select" required>
                            <optgroup label="Income Heads">
                                @foreach (var h in accountHeads.Where(x => x.Type == EasyAlumni.Core.Enums.AccountHeadType.Income))
                                {
                                    <option value="@h.Id">@h.HeadName</option>
                                }
                            </optgroup>
                            <optgroup label="Expense Heads">
                                @foreach (var h in accountHeads.Where(x => x.Type == EasyAlumni.Core.Enums.AccountHeadType.Expense))
                                {
                                    <option value="@h.Id">@h.HeadName</option>
                                }
                            </optgroup>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount (BDT) <span class="text-danger">*</span></label>
                        <input type="number" step="1" name="amount" id="editVoucherAmount" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Mode</label>
                        <select name="paymentMode" id="editVoucherMode" class="form-select">
                            <option value="Cash">Cash</option>
                            <option value="bKash">bKash</option>
                            <option value="Nagad">Nagad</option>
                            <option value="Rocket">Rocket</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description / Purpose</label>
                        <textarea name="description" id="editVoucherDesc" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Replace Receipt / Bill Attachment (Optional)</label>
                        <input type="file" name="receiptFile" class="form-control" accept="image/*,application/pdf" />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Adjust Budget Modal -->
<div class="modal fade" id="budgetModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="Accounting" asp-action="UpdateBudgetHead" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="budgetHeadId" id="budgetHeadId" />
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" id="budgetHeadName">Adjust Budget</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Allocated Budget (BDT)</label>
                        <input type="number" step="1" name="allocatedAmount" id="allocatedAmount" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Update Budget</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#cashTable').DataTable({
                pageLength: 10,
                ordering: false
            });
        });

        function openBudgetModal(id, name, amount) {
            document.getElementById('budgetHeadId').value = id;
            document.getElementById('budgetHeadName').innerText = `Adjust Budget for ${name}`;
            document.getElementById('allocatedAmount').value = amount;
            new bootstrap.Modal(document.getElementById('budgetModal')).show();
        }

        function openEditVoucherModal(id, voucherNo, headId, amount, mode, desc) {
            document.getElementById('editVoucherId').value = id;
            document.getElementById('editVoucherNumber').innerText = voucherNo;
            document.getElementById('editVoucherHeadId').value = headId;
            document.getElementById('editVoucherAmount').value = amount;
            document.getElementById('editVoucherMode').value = mode;
            document.getElementById('editVoucherDesc').value = desc || '';
            new bootstrap.Modal(document.getElementById('editVoucherModal')).show();
        }
    </script>
}
