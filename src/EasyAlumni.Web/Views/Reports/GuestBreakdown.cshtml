@model IEnumerable<EasyAlumni.Core.Entities.RegistrationGuest>
@{
    ViewData["Title"] = "Guest Breakdown (Age & Gender) Report";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as List<EasyAlumni.Core.Entities.GuestCategory> ?? new();
    var events = ViewBag.Events as List<EasyAlumni.Core.Entities.ReunionEvent> ?? new();
    var categoryBreakdown = ViewBag.CategoryBreakdown as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    int? selectedEventId = ViewBag.SelectedEventId as int?;
    int? selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    string? selectedGender = ViewBag.SelectedGender as string;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">Accompanying Guest Demographics &amp; Headcount</h2>
        <p class="text-muted small mb-0">Breakdown of accompanying family and guests by Category, Gender, Age group, and Admission eligibility</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportGuestsCsv" 
           asp-route-eventId="@selectedEventId" 
           asp-route-categoryId="@selectedCategoryId" 
           asp-route-gender="@selectedGender" 
           class="btn btn-outline-success rounded-pill px-3 fw-semibold">
            <i class="fas fa-file-csv me-1"></i> Export Guests CSV
        </a>
        <button type="button" class="btn btn-warning rounded-pill px-3" onclick="window.print()">
            <i class="fas fa-print me-1"></i> Print / PDF
        </button>
    </div>
</div>

<!-- Report Navigation Tabs / Shortcuts -->
<div class="card border-0 shadow-sm rounded-4 mb-4 p-2 bg-white">
    <div class="nav nav-pills nav-fill gap-2">
        <a class="nav-link text-dark rounded-pill fw-semibold py-2" asp-controller="Reports" asp-action="Index">
            Summary Overview
        </a>
        <a class="nav-link text-dark rounded-pill fw-semibold py-2" asp-controller="Reports" asp-action="CollectionReport">
            Fee Collection Audit
        </a>
        <a class="nav-link text-dark rounded-pill fw-semibold py-2" asp-controller="Reports" asp-action="CateringReport">
            Catering Headcount
        </a>
        <a class="nav-link active rounded-pill fw-semibold py-2" asp-controller="Reports" asp-action="GuestBreakdown">
            Guest Breakdown (Age &amp; Gender)
        </a>
        <a class="nav-link text-dark rounded-pill fw-semibold py-2" asp-controller="Reports" asp-action="CustomResponses">
            Custom Responses (Cultural/Volunteers)
        </a>
        <a class="nav-link text-dark rounded-pill fw-semibold py-2" asp-controller="Reports" asp-action="TShirtReport">
            T-Shirt Inventory
        </a>
    </div>
</div>

<!-- KPI Stat Cards: Headcount, Gender, Age -->
<div class="row g-3 mb-4">
    <div class="col-lg-2 col-md-4 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center bg-primary text-white h-100">
            <span class="small opacity-80 text-uppercase">Total Guests</span>
            <h2 class="fw-bold mb-0">@ViewBag.TotalGuests</h2>
            <small class="opacity-75">Headcount</small>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center bg-info text-white h-100">
            <span class="small opacity-80 text-uppercase">Male Guests</span>
            <h2 class="fw-bold mb-0">@ViewBag.TotalMale</h2>
            <small class="opacity-75">Boys &amp; Men</small>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center bg-success text-white h-100">
            <span class="small opacity-80 text-uppercase">Female Guests</span>
            <h2 class="fw-bold mb-0">@ViewBag.TotalFemale</h2>
            <small class="opacity-75">Girls &amp; Women</small>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center bg-warning text-dark h-100">
            <span class="small opacity-80 text-uppercase">Under 5 Yrs</span>
            <h2 class="fw-bold mb-0">@ViewBag.TotalUnder5</h2>
            <small class="text-muted">Infants / Toddlers</small>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center bg-secondary text-white h-100">
            <span class="small opacity-80 text-uppercase">5 - 12 Yrs</span>
            <h2 class="fw-bold mb-0">@ViewBag.TotalChildren5To12</h2>
            <small class="opacity-75">Children</small>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center bg-dark text-white h-100">
            <span class="small opacity-80 text-uppercase">Guest Fees</span>
            <h2 class="fw-bold mb-0 text-warning">৳ @(((decimal)ViewBag.TotalFees).ToString("N0"))</h2>
            <small class="opacity-75">Revenue</small>
        </div>
    </div>
</div>

<!-- Category Summary Matrix -->
<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
    <div class="card-header bg-white p-3 border-bottom">
        <h5 class="fw-bold text-dark mb-0"><i class="fas fa-layer-group text-success me-2"></i> Category Summary Matrix</h5>
    </div>
    <div class="table-responsive p-3">
        <table class="table table-hover table-bordered align-middle text-center mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th class="text-start">Category Name</th>
                    <th>Total Headcount</th>
                    <th>Male Guests</th>
                    <th>Female Guests</th>
                    <th class="text-end">Total Guest Fees (BDT)</th>
                </tr>
            </thead>
            <tbody>
                @if (!categoryBreakdown.Any())
                {
                    <tr>
                        <td colspan="5" class="text-muted py-3">No guest categories found for this event.</td>
                    </tr>
                }
                else
                {
                    @foreach (var c in categoryBreakdown)
                    {
                        <tr>
                            <td class="text-start fw-bold text-dark">@c.Category</td>
                            <td><span class="badge bg-primary-subtle text-primary border fs-6 px-3 py-1">@c.Count Heads</span></td>
                            <td>@c.MaleCount</td>
                            <td>@c.FemaleCount</td>
                            <td class="text-end fw-bold text-success">৳ @(((decimal)c.TotalFee).ToString("N0"))</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="GuestBreakdown" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Category</label>
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">-- All Guest Categories --</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(selectedCategoryId == cat.Id)">@cat.CategoryName (৳ @cat.Fee.ToString("N0"))</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Gender</label>
                <select name="gender" class="form-select form-select-sm">
                    <option value="">-- All Genders --</option>
                    <option value="Male" selected="@(selectedGender == "Male")">Male (পুরুষ)</option>
                    <option value="Female" selected="@(selectedGender == "Female")">Female (নারী)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Event</label>
                <select name="eventId" class="form-select form-select-sm">
                    @foreach (var e in events)
                    {
                        <option value="@e.Id" selected="@(selectedEventId == e.Id)">@e.EventTitle (@e.EventDate.Year)</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end gap-1 mt-3 mt-md-0">
                <button type="submit" class="btn btn-success btn-sm rounded-pill w-100 fw-semibold">
                    <i class="fas fa-filter me-1"></i> Filter
                </button>
                <a asp-action="GuestBreakdown" class="btn btn-outline-secondary btn-sm rounded-pill" title="Reset Filters">
                    <i class="fas fa-undo"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Detailed Guest Roster Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold text-dark mb-0">Registered Guest Roster</h5>
        <span class="badge bg-light text-dark border">Showing @Model.Count() guest(s)</span>
    </div>
    <div class="table-responsive p-3">
        <table class="table table-hover table-bordered align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th>Registration Ticket</th>
                    <th>Accompanying Alumnus</th>
                    <th>Guest Category</th>
                    <th>Guest Full Name</th>
                    <th class="text-center">Gender</th>
                    <th class="text-center">Age (Years)</th>
                    <th>Fee Charged</th>
                    <th class="text-center">Ticket Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fas fa-user-friends fa-3x mb-3 text-secondary opacity-50"></i>
                            <p class="mb-0">No accompanying guests found for the selected filters.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var g in Model)
                    {
                        var reg = g.EventRegistration;
                        var prof = reg?.AlumniProfile;
                        var isUnder5 = g.Age.HasValue && g.Age.Value < 5;

                        <tr>
                            <td>
                                <strong class="text-primary">@reg?.RegistrationNo</strong>
                                <small class="d-block text-muted">@prof?.UserCode</small>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@prof?.NameEnglish</div>
                                <small class="text-muted"><i class="fas fa-graduation-cap me-1"></i> Batch @prof?.PassingYear | <i class="fas fa-phone me-1"></i> @prof?.ContactNumber</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 fs-6">
                                    @g.GuestCategory?.CategoryName
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(g.GuestName))
                                {
                                    <span class="fw-bold text-dark">@g.GuestName</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Accompanying @(g.GuestCategory?.CategoryName ?? "Guest")</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (string.Equals(g.Gender, "Female", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger-subtle text-danger border px-2 py-1">
                                        <i class="fas fa-venus me-1"></i> Female
                                    </span>
                                }
                                else if (string.Equals(g.Gender, "Male", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-primary-subtle text-primary border px-2 py-1">
                                        <i class="fas fa-mars me-1"></i> Male
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">@(g.Gender ?? "N/A")</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (g.Age.HasValue)
                                {
                                    <span class="fw-bold">@g.Age.Value yrs</span>
                                    @if (isUnder5)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border d-block mt-1">Under 5</span>
                                    }
                                    else if (g.Age.Value <= 12)
                                    {
                                        <span class="badge bg-info-subtle text-info border d-block mt-1">Child (5-12)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border d-block mt-1">Adult</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td class="fw-bold text-success">
                                ৳ @g.FeeCharged.ToString("N0")
                            </td>
                            <td class="text-center">
                                @if (reg?.Status == EasyAlumni.Core.Enums.RegistrationStatus.Approved)
                                {
                                    <span class="badge bg-success-subtle text-success border">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border">@(reg?.Status.ToString() ?? "Pending")</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
