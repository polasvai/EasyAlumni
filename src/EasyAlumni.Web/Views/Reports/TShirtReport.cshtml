@model EasyAlumni.Core.Entities.GiftItem
@{
    ViewData["Title"] = "T-Shirt Size Distribution Report";
    Layout = "_AdminLayout";
    var demands = (Dictionary<string, int>)ViewBag.RegisteredDemands;
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold text-dark mb-1">T-Shirt Procurement &amp; Distribution Report</h2>
        <p class="text-muted small mb-0">Reconcile ordered stock, registered attendee demand, and physical gate handovers</p>
    </div>
    <div>
        <button type="button" class="btn btn-warning rounded-pill px-3" onclick="window.print()">
            Print / PDF
        </button>
    </div>
</div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-dark mb-0">@(Model?.ItemName ?? "Polo T-Shirt") - Size Reconciliation Matrix</h5>
            <span class="badge bg-success rounded-pill px-3 py-2">Total Procured: @(Model?.TotalStockQuantity ?? 0) Pcs</span>
        </div>
        <div class="table-responsive p-3">
            <table class="table table-bordered table-hover align-middle text-center mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Size Code</th>
                        <th>Procured Stock</th>
                        <th>Attendee Demand (Approved)</th>
                        <th>Actually Handed Over</th>
                        <th>Surplus / Deficit in Stock</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.SizeStocks.Any())
                    {
                        @foreach (var s in Model.SizeStocks.OrderBy(x => x.SizeName))
                        {
                            var demand = demands.GetValueOrDefault(s.SizeName, 0);
                            var surplus = s.TotalStock - demand;
                            <tr>
                                <td><strong class="fs-5 text-primary">@s.SizeName</strong></td>
                                <td><strong>@s.TotalStock</strong></td>
                                <td><span class="badge bg-info text-dark fs-6">@demand</span></td>
                                <td><span class="badge bg-success fs-6">@s.DistributedStock</span></td>
                                <td>
                                    @if (surplus >= 0)
                                    {
                                        <span class="badge bg-success fs-6">+@surplus Pcs Surplus</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6">@surplus Pcs Shortage!</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td>TOTAL:</td>
                        <td>@(Model?.TotalStockQuantity ?? 0) Pcs</td>
                        <td>@demands.Values.Sum() Pcs</td>
                        <td>@(Model?.DistributedQuantity ?? 0) Pcs</td>
                        <td>
                            @{
                                var netSurplus = (Model?.TotalStockQuantity ?? 0) - demands.Values.Sum();
                            }
                            <span class="@(netSurplus >= 0 ? "text-success" : "text-danger") fs-6">
                                @(netSurplus >= 0 ? $"+{netSurplus} Pcs Overall" : $"{netSurplus} Pcs Shortage")
                            </span>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
